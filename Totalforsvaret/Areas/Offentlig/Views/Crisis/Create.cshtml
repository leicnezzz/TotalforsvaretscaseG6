
@model Totalforsvaret.Models.Crisis

@{
    ViewData["Title"] = ViewData["EditId"] != null
        ? "Endre krise"
        : "Opprett krise";
    ViewData["FullWidth"] = true;
    ViewData["RegistrationFooter"] = true;
}
<link rel="stylesheet" href="~/css/site-header.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/resource-registration.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/resource-wizard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/need-registration.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/offentlig-motion.css" asp-append-version="true" />

<div class="need-page">
    <div class="private-page-actions">
        <a asp-area="" asp-controller="OffentligAktor" asp-action="Index"
           class="private-page-action">← Tilbake</a>
    </div>
    <div class="registration-content need-registration">
        <section class="registration-intro" aria-labelledby="need-title">
            <h1 id="need-title">@ViewData["Title"]</h1>
            <p>Beskriv situasjonen og oppgi hvilket område som er berørt.</p>
        </section>

        <form asp-area="Offentlig"
          asp-controller="Crisis"
          asp-action="@(ViewData["EditId"] != null ? "Edit" : "Create")"
          asp-route-id="@(ViewData["EditId"])"
          method="post" class="resource-wizard need-card" data-need-wizard>

            <div asp-validation-summary="All" class="text-danger"></div>

            <section data-need-step>
                <h2 class="need-step-title" tabindex="-1">Hva har skjedd?</h2>
                <p class="need-step-intro">
                    Fyll ut opplysningene om krisen.
                </p>
                <div class="row gy-3">
                    <div class="col-md-6 wizard-fields">
                        <label asp-for="Name" class="form-label">Navn på krisen</label>
                        <input asp-for="Name" class="form-control"
                               placeholder="For eksempel Flom i Kristiansand sentrum"
                               maxlength="100" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 wizard-fields">
                        <label asp-for="Type" class="form-label">Type krise</label>
                        <select asp-for="Type" class="form-select" required>
                            <option value="">Velg type</option>
                            <option value="Flom">Flom</option>
                            <option value="Brann">Brann</option>
                            <option value="Strømbrudd">Strømbrudd</option>
                            <option value="Ekstremvær">Ekstremvær</option>
                            <option value="Annet">Annet</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 wizard-fields">
                        <label asp-for="Area" class="form-label">Område</label>
                        <input asp-for="Area" class="form-control"
                               placeholder="For eksempel Kristiansand"
                               maxlength="100" required />
                        <span asp-validation-for="Area" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 wizard-fields">
                        <label asp-for="Severity" class="form-label">Alvorlighetsgrad</label>
                        <select asp-for="Severity" class="form-select" required>
                            <option value="">Velg alvorlighetsgrad</option>
                            <option value="Lav">Lav</option>
                            <option value="Middels">Middels</option>
                            <option value="Høy">Høy</option>
                            <option value="Kritisk">Kritisk</option>
                        </select>
                        <span asp-validation-for="Severity" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 wizard-fields">
                        <label asp-for="StartTime" class="form-label">Starttidspunkt</label>
                        <input asp-for="StartTime"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               step="any"
                               class="form-control"
                               required/>
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 wizard-fields">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select" required>
                            <option value="">Velg status</option>
                            <option value="Aktiv">Aktiv</option>
                            <option value="Under kontroll">Under kontroll</option>
                            <option value="Avsluttet">Avsluttet</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <div class="col-12 wizard-fields">
                        <label asp-for="Description" class="form-label">Beskriv krisen</label>
                        <textarea asp-for="Description" class="form-control"
                                  rows="5" maxlength="1500" required></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <input asp-for="Latitude" type="hidden" />
            <input asp-for="Longitude" type="hidden" />

            <section data-need-step hidden>
                <h2 class="need-step-title" tabindex="-1">Se over informasjonen</h2>
                <p class="need-step-intro">Kontroller opplysningene før du lagrer krisen.</p>
                <dl class="need-review" data-need-review></dl>
            </section>

            <div class="need-actions">
                <div>
                    <a asp-area="" asp-controller="OffentligAktor" asp-action="Index"
                   class="public-button public-button-outline" data-need-cancel>Avbryt</a>
                    <button type="button" class="public-button public-button-outline" data-need-back hidden>← Tilbake</button>
                </div>
                <button type="button" class="public-button public-button-primary" data-need-next hidden>Neste →</button>
                <button type="submit" class="public-button public-button-primary" data-need-submit>
                    @(ViewData["EditId"] != null ? "Lagre endringer" : "Opprett krise")
                </button>
            </div>
        </form>

        @if (ViewData["EditId"] != null)
        {
            <form asp-area="Offentlig"
              asp-controller="Crisis"
              asp-action="Delete"
              asp-route-id="@(ViewData["EditId"])"
              method="post"
              class="resource-wizard mt-3"
              onsubmit="return confirm('Er du sikker på at du vil slette hele denne krisen og ALLE behov som er knyttet til den? Behovene fjernes også fra aktive behov og kartet. Dette kan ikke angres.');">

                <button type="submit" class="public-button public-button-outline need-delete">
                    Slett krise og tilknyttede behov
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/need-registration.js" asp-append-version="true"></script>
}
