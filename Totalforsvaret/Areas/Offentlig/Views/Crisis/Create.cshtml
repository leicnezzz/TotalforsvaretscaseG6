
@model Totalforsvaret.Models.Crisis

@{
    ViewData["Title"] = ViewData["EditId"] != null
        ? "Endre krise"
        : "Opprett krise";
}

<div class="container py-4">
    <h1>@ViewData["Title"]</h1>
    <p>Registrer krisen før du legger til behov.</p>

    <form asp-area="Offentlig"
          asp-controller="Crisis"
          asp-action="@(ViewData["EditId"] != null ? "Edit" : "Create")"
          asp-route-id="@(ViewData["EditId"])"
          method="post">

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Navn på krisen</label>
            <input asp-for="Name" class="form-control"
                   placeholder="For eksempel Flom i Otra"
                   maxlength="100" required />
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">Type krise</label>
            <select asp-for="Type" class="form-select" required>
                <option value="">Velg type</option>
                <option value="Flom">Flom</option>
                <option value="Brann">Brann</option>
                <option value="Strømbrudd">Strømbrudd</option>
                <option value="Ekstremvær">Ekstremvær</option>
                <option value="Annet">Annet</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Area" class="form-label">Område</label>
            <input asp-for="Area" class="form-control"
                   placeholder="For eksempel Kristiansand"
                   maxlength="100" required />
        </div>

        <div class="mb-3">
            <label asp-for="Severity" class="form-label">Alvorlighetsgrad</label>
            <select asp-for="Severity" class="form-select" required>
                <option value="">Velg alvorlighetsgrad</option>
                <option value="Lav">Lav</option>
                <option value="Middels">Middels</option>
                <option value="Høy">Høy</option>
                <option value="Kritisk">Kritisk</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="StartTime" class="form-label">Starttidspunkt</label>
            <input asp-for="StartTime" type="datetime-local"
                   class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select" required>
                <option value="">Velg status</option>
                <option value="Aktiv">Aktiv</option>
                <option value="Under kontroll">Under kontroll</option>
                <option value="Avsluttet">Avsluttet</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Beskriv krisen</label>
            <textarea asp-for="Description" class="form-control"
                      rows="5" maxlength="1500" required></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Velg plassering på kartet</label>
            <p>Klikk på kartet for å plassere krisen.</p>

            <div id="kriseKart" style="height: 350px; width: 100%;"></div>

            <input asp-for="Latitude" type="hidden" id="Latitude" />
            <input asp-for="Longitude" type="hidden" id="Longitude" />

            <p id="kriseKartmelding" class="small text-muted mt-2">
                Ingen plassering valgt.
            </p>
        </div>
        
        <button type="submit" class="btn btn-success">
            @(ViewData["EditId"] != null ? "Endre krise" : "Opprett krise")
        </button>

        <a asp-area=""
           asp-controller="OffentligAktor"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Avbryt
        </a>
    </form>
    @if (ViewData["EditId"] != null)
    {
        <form asp-area="Offentlig"
              asp-controller="Crisis"
              asp-action="Delete"
              asp-route-id="@(ViewData["EditId"])"
              method="post"
              class="mt-3"
              onsubmit="return confirm('Er du sikker på at du vil slette hele denne krisen og ALLE behov som er knyttet til den? Behovene fjernes også fra aktive behov og kartet. Dette kan ikke angres.');">

            <button type="submit" class="btn btn-danger">
                Slett krise og tilknyttede behov
            </button>
        </form>
    }
</div>

@section Scripts {
    <script>
        (() => {
            const kartElement = document.getElementById('kriseKart');
            const melding = document.getElementById('kriseKartmelding');
            const latitudeInput = document.getElementById('Latitude');
            const longitudeInput = document.getElementById('Longitude');

            if (typeof L === 'undefined') {
                melding.textContent = 'Kartet kunne ikke lastes.';
                return;
            }

            const kart = L.map('kriseKart')
                .setView([58.1467, 7.9956], 12);

            L.tileLayer(
                'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }
            ).addTo(kart);

            let markor = null;

            kart.on('click', function (e) {
                const latitude = e.latlng.lat;
                const longitude = e.latlng.lng;

                latitudeInput.value = latitude;
                longitudeInput.value = longitude;

                if (markor) {
                    kart.removeLayer(markor);
                }

                markor = L.marker([latitude, longitude])
                    .addTo(kart);

                melding.textContent =
                    `Valgt plassering: ${latitude.toFixed(5)}, ${longitude.toFixed(5)}`;
            });
        })();
    </script>
}