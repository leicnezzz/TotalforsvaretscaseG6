@model Totalforsvaret.Models.resourcemodels.Resource
@using System.Globalization
@{
    ViewData["Title"] = "Innsendte data";
}

<h2>Innsendte data</h2>
<div class="card p-3">
    <p><strong>Navn:</strong> <span id="resourceName">@Model.Navn</span></p>
    <p><strong>Type ressurs:</strong> @Model.Object</p>
    <p><strong>Ressursnummer:</strong> @Model.ResourceId</p>
    <p><strong>Kategori:</strong> @Model.Category.Name</p>
    <p><strong>Tilgjengelig:</strong> @(Model.Available ? "Ja" : "Nei")</p>
    <p><strong>Tilgjengelig fra:</strong> @(Model.TilgjengeligFra?.ToString("dd.MM.yyyy HH:mm"))</p>
    <p><strong>Kontaktpunkt:</strong> @Model.Kontaktpunkt</p>
    <p><strong>Breddegrad:</strong> @Model.Latitude</p>
    <p><strong>Lengdegrad:</strong> @Model.Longitude</p>
</div>

<h3 class="mt-4">Valgt posisjon</h3>
<div id="resourceMap" style="height: 350px" data-latitude="@Model.Latitude.ToString(CultureInfo.InvariantCulture)"
     data-longitude="@Model.Longitude.ToString(CultureInfo.InvariantCulture)" aria-label="Ressursens posisjon"></div>
<a asp-action="Skjema" class="btn btn-secondary mt-3">Tilbake til skjema</a>

@section Scripts {
    <script src="~/js/resource-form.js" asp-append-version="true"></script>
}
