@model Totalforsvaret.Areas.Offentlig.ViewModels.MultipleNeedsViewModel

@{
    ViewData["Title"] = "Registrer flere behov";
}

<link rel="stylesheet"
      href="~/css/offentlig-aktor.css"
      asp-append-version="true" />

<div class="container pt-4 pb-5 mb-5 offentlig-behov-side">
    <a asp-area=""
       asp-controller="OffentligAktor"
       asp-action="Index"
       class="tilbake-oversikt">
        ← Tilbake til oversikten
    </a>

    <h1>@ViewData["Title"]</h1>
    <p>Velg en hendelse og registrer ressursbehovene som hører til.</p>

    <form id="flereBehovSkjema" asp-area="Offentlig"
          asp-controller="Need"
          asp-action="CreateMultiple"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CrisisId" class="form-label">Tilknyttet hendelse</label>
            <select asp-for="CrisisId" asp-items="Model.Crises" class="form-select" required>
                <option value="">Velg hendelse</option>
            </select>
            @if (!Model.Crises.Any())
            {
                <p class="form-text">Opprett en hendelse før du registrerer behov.</p>
            }
            <span asp-validation-for="CrisisId" class="text-danger"></span>
        </div>

        <span asp-validation-for="Needs" class="text-danger"></span>
        <div id="behov-liste">
            @for (var i = 0; i < Model.Needs.Count; i++)
            {
                <fieldset class="behov-element mb-4">
                    <legend class="h5">Behov @(i + 1)</legend>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm fjern-behov mb-3">
                        Fjern behov
                    </button>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Needs[i].Name" class="form-label">
                                Navn på behovet
                            </label>
                            <input asp-for="Needs[i].Name"
                                   class="form-control"
                                   placeholder="For eksempel Sand til Vennesla"
                                   maxlength="100" />
                            <span asp-validation-for="Needs[i].Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Needs[i].Type" class="form-label">
                                Type behov
                            </label>
                            <select asp-for="Needs[i].Type" class="form-select">
                                <option value="">Velg type</option>
                                <option value="Utstyr">Utstyr</option>
                                <option value="Transport">Kjøretøy</option>
                            </select>
                            <span asp-validation-for="Needs[i].Type"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Needs[i].Priority" class="form-label">
                                Prioritet
                            </label>
                            <select asp-for="Needs[i].Priority" class="form-select">
                                <option value="">Velg prioritet</option>
                                <option value="Lav">Lav</option>
                                <option value="Middels">Middels</option>
                                <option value="Høy">Høy</option>
                                <option value="Kritisk">Kritisk</option>
                            </select>
                            <span asp-validation-for="Needs[i].Priority"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Needs[i].Status" class="form-label">
                                Status
                            </label>
                            <select asp-for="Needs[i].Status" class="form-select">
                                <option value="Åpen">Åpen</option>
                                <option value="Under behandling">Under behandling</option>
                                <option value="Løst">Løst</option>
                            </select>
                            <span asp-validation-for="Needs[i].Status"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Needs[i].Description" class="form-label">
                            Beskrivelse
                        </label>
                        <textarea asp-for="Needs[i].Description"
                          class="form-control"
                          rows="3"
                          placeholder="Beskriv situasjonen, omfanget og hva det er behov for"
                          maxlength="1500"></textarea>
                        <span asp-validation-for="Needs[i].Description"
                              class="text-danger"></span>
                    </div>
                </fieldset>
            }
        </div>

        <div class="mt-4 pt-4 border-top" data-behovplassering>
            <h2 class="h5">Hvor trengs behovene?</h2>
            <p class="text-muted">
                Velg en aktiv hendelse i listen eller på kartet for å bruke hendelsens plassering. Du kan også klikke et annet sted på kartet.
            </p>

            <div id="behovKart" style="height: 350px; width: 100%;"></div>

            <input asp-for="Latitude" type="hidden" />
            <input asp-for="Longitude" type="hidden" />
            <input name="__Invariant" type="hidden" value="Latitude" />
            <input name="__Invariant" type="hidden" value="Longitude" />

            <span asp-validation-for="Latitude" class="text-danger"></span>
            <span asp-validation-for="Longitude" class="text-danger"></span>

            <p id="behovKartmelding" class="small text-muted mt-2">
                Ingen plassering valgt.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="button"
                    id="legg-til-behov"
                    class="btn btn-outline-secondary me-auto">
                + Legg til behov
            </button>

            <button type="submit" class="btn btn-success">
                Registrer behovene
            </button>

            <a asp-area=""
               asp-controller="OffentligAktor"
               asp-action="Index"
               class="btn btn-outline-secondary" data-avbryt-behov>
                Avbryt
            </a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="~/Areas/Homepage/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script src="~/js/behov-liste.js" asp-append-version="true"></script>

    <script>
        window.kobleBehovsliste(document.getElementById('flereBehovSkjema'));
        const kartmelding = document.getElementById('behovKartmelding');
        const latitudeInput = document.getElementById('Latitude');
        const longitudeInput = document.getElementById('Longitude');
        const krisevalg = document.getElementById('CrisisId');
        const aktiveKriser = @Json.Serialize(Model.ActiveCrisesOnMap);

        if (typeof L !== 'undefined') {
            const kart = L.map('behovKart')
                .setView([58.1467, 7.9956], 12);

            L.tileLayer(
                'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }
            ).addTo(kart);

            let markor = null;

            function visPlassering(latitude, longitude) {
                const plassering = [latitude, longitude];

                if (markor) {
                    markor.setLatLng(plassering);
                } else {
                    markor = L.marker(plassering, {
                        title: 'Behovets valgte plassering',
                        alt: 'Behovets valgte plassering'
                    }).addTo(kart);
                }

                kartmelding.textContent =
                    `Valgt plassering: ${latitude.toFixed(5)}, ${longitude.toFixed(5)}`;
            }

            function velgPlassering(latitude, longitude) {
                latitudeInput.value = latitude;
                longitudeInput.value = longitude;
                visPlassering(latitude, longitude);
            }

            const krisemarkorer = L.featureGroup().addTo(kart);

            const hendelsesikon = L.divIcon({
                className: 'hendelse-kartikon',
                html:
                    '<svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">' +
                    '<polygon points="14,3 25,25 3,25" ' +
                    'fill="#DA2727" stroke="black" stroke-width="3" ' +
                    'stroke-linejoin="round"></polygon></svg>',
                iconSize: [28, 28],
                iconAnchor: [14, 25]
            });

            function visValgtHendelse() {
                krisemarkorer.clearLayers();

                const hendelse = aktiveKriser.find(
                    item => String(item.id) === krisevalg.value
                );

                if (!hendelse) return null;

                const navn = document.createElement('span');
                navn.textContent = hendelse.name;

                L.marker([hendelse.latitude, hendelse.longitude], {
                    icon: hendelsesikon,
                    title: hendelse.name,
                    alt: 'Valgt hendelse: ' + hendelse.name,
                    bubblingMouseEvents: false
                })
                    .bindTooltip(navn)
                    .on('click', () => {
                        velgPlassering(hendelse.latitude, hendelse.longitude);
                    })
                    .addTo(krisemarkorer);

                return hendelse;
            }

            krisevalg.addEventListener('change', () => {
                const hendelse = visValgtHendelse();

                if (!hendelse) {
                    latitudeInput.value = '';
                    longitudeInput.value = '';

                    if (markor) {
                        markor.remove();
                        markor = null;
                    }

                    kartmelding.textContent = krisevalg.value
                        ? 'Hendelsen mangler kartplassering en gyldig kartplassering. ' +
                        'Klikk på kartet for å velge behovets plassering.'
                        : 'Velg en hendelse og deretter behovets plassering.';

                    return;
                }

                velgPlassering(hendelse.latitude, hendelse.longitude);
                kart.setView([hendelse.latitude, hendelse.longitude], 13);

                kartmelding.textContent =
                    'Behovets plassering er satt til hendelsen: ' + hendelse.name;
            });

// Vis trekanten også når hendelsen allerede er valgt ved sidelasting.
            visValgtHendelse();
            
            // Beholder valgt plassering hvis skjemaet får valideringsfeil.
            if (latitudeInput.value.trim() && longitudeInput.value.trim()) {
                const latitude = Number(latitudeInput.value.replace(',', '.'));
                const longitude = Number(longitudeInput.value.replace(',', '.'));

                if (Number.isFinite(latitude) &&
                    Number.isFinite(longitude) &&
                    latitude >= -90 && latitude <= 90 &&
                    longitude >= -180 && longitude <= 180) {
                    visPlassering(latitude, longitude);
                    kart.setView([latitude, longitude], 12);
                }
            }

            if (!markor && krisevalg.value) {
                krisevalg.dispatchEvent(new Event('change'));
            }

            kart.on('click', e => {
                velgPlassering(e.latlng.lat, e.latlng.lng);
            });
        } else {
            kartmelding.textContent = 'Kartet kunne ikke lastes.';
        }
    </script>
}