@model Totalforsvaret.Areas.Privat.Models.InboxViewModel
@using Totalforsvaret.Areas.Offentlig.Models

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Innboks – Paratus</title>

    <link rel="stylesheet"
          href="~/css/site-header.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Inbox.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Inbox-offentlig.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offentlig-motion.css" asp-append-version="true" />
</head>

<body class="inbox-page offentlig-page offentlig-inbox">
    <partial name="/Areas/Offentlig/Views/Shared/_OffentligNavigation.cshtml" />

    <partial name="/Areas/Offentlig/Views/Shared/_OffentligTilbake.cshtml" />

    <main class="inbox-main">

        <section class="inbox-card" aria-labelledby="inbox-title">

            @if (TempData["InboxMessage"] is string notice)
            {
                <p class="inbox-flash" role="status">
                    @notice
                </p>
            }

            @if (Model.Items.Count == 0)
            {
                <div class="inbox-empty">
                    <h1 id="inbox-title">Innboks</h1>
                    <h2>Ingen matcher ennå</h2>
                    <p>
                        Matcher og meldinger knyttet til dem vises her.
                    </p>
                </div>
            }
            else if (Model.SelectedItem is { } item)
            {
                <div class="inbox-layout">
                    <aside class="inbox-sidebar">
                        <h1 id="inbox-title">Innboks</h1>

                        <nav class="inbox-list"
                             aria-label="Matcher">

                            @foreach (var listItem in Model.Items)
                            {
                                var selected =
                                    listItem.AssignmentId == Model.SelectedId;

                                <a class="inbox-list-item @(selected ? "is-selected" : "")"
                                   asp-area="Offentlig"
                                   asp-controller="Inbox"
                                   asp-action="Index"
                                   asp-route-selectedId="@listItem.AssignmentId"
                                   aria-current="@(selected ? "true" : null)">

                                    <span class="inbox-list-icon"
                                          aria-hidden="true">
                                        @if (listItem.CategoryName == "Vehicles")
                                        {
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16v-4l1.8-4.2A2 2 0 0 1 7.7 6.5h8.6a2 2 0 0 1 1.9 1.3L20 12v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="M4 12h16"/><circle cx="8" cy="14.5" r=".6"/><circle cx="16" cy="14.5" r=".6"/></svg>
                                        }
                                        else
                                        {
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
                                        }
                                    </span>

                                    <span class="inbox-list-copy">
                                        <strong>@listItem.ResourceName</strong>
                                        <span>@listItem.NeedName</span>
                                        <small class="@(listItem.Status == AssignmentStatus.Requested ? "is-waiting" : "")">@listItem.StatusLabel</small>
                                    </span>
                                </a>
                            }
                        </nav>
                    </aside>

                    <div class="inbox-detail">
                        <div class="inbox-detail-heading">
                            <div>
                                <p class="inbox-eyebrow">
                                    Match om ressurs
                                </p>
                                <h2>@item.ResourceName</h2>
                            </div>

                            <div class="inbox-heading-side">
                                <span class="inbox-status @(item.Status == AssignmentStatus.Requested ? "is-waiting" : "")">
                                    @item.StatusLabel
                                </span>

                                @if (item.CanManageAssignment &&
                                     item.Status == AssignmentStatus.Requested)
                                {
                                    <div class="inbox-actions">
                                        <form asp-area="Offentlig"
                                              asp-controller="Inbox"
                                              asp-action="Decline"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="assignmentId"
                                                   value="@item.AssignmentId" />

                                            <button class="inbox-button inbox-button-secondary"
                                                    type="submit">
                                                Avslå
                                            </button>
                                        </form>

                                        <form asp-area="Offentlig"
                                              asp-controller="Inbox"
                                              asp-action="Accept"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="assignmentId"
                                                   value="@item.AssignmentId" />

                                            <button class="inbox-button inbox-button-primary"
                                                    type="submit">
                                                Godta
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (item.CanManageAssignment &&
                                         item.Status == AssignmentStatus.Assigned)
                                {
                                    <div class="inbox-actions">
                                        <form asp-area="Offentlig"
                                              asp-controller="Inbox"
                                              asp-action="Release"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="assignmentId"
                                                   value="@item.AssignmentId" />

                                            <button class="inbox-button inbox-button-secondary"
                                                    type="submit">
                                                Frigi ressurs
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="inbox-content">
                            <partial name="/Areas/Homepage/Views/Shared/_InboxSummary.cshtml" model="item" />

                            <section class="inbox-conversation"
                                     aria-labelledby="inbox-conversation-title">
                                <div class="inbox-conversation-head">
                                    <h3 id="inbox-conversation-title">Samtale om denne matchen</h3>
                                    <span>
                                        Forespurt @(item.RequestedAtUtc.ToLocalTime()
                                            .ToString("dd.MM.yyyy HH:mm"))
                                    </span>
                                </div>

                                <partial name="/Areas/Homepage/Views/Shared/_InboxMessages.cshtml" model="Model" />

                                <form class="inbox-message-form"
                                      asp-area="Offentlig"
                                      asp-controller="Inbox"
                                      asp-action="Reply"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="assignmentId"
                                           value="@item.AssignmentId" />

                                    <label for="public-message-body">
                                        Svar i samtalen
                                    </label>

                                    <textarea id="public-message-body"
                                              name="body"
                                              rows="2"
                                              placeholder="Svar i samtalen …"
                                              maxlength="2000"
                                              required></textarea>

                                    <button class="inbox-button inbox-button-primary"
                                            type="submit">
                                        Send svar
                                    </button>
                                </form>
                            </section>
                        </div>
                    </div>
                </div>
            }
        </section>
    </main>
</body>
</html>