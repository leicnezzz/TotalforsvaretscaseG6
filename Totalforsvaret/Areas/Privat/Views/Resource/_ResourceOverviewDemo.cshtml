@* DEMO START. Erstatt denne partialen med serverrendret HTML for brukerens ressurser.
   Behold feltnavn og data-resource-id ved kobling til en viewmodell.
   Alle endringer i disse kortene gjelder bare den åpne siden. *@
<details class="resource-item" data-resource-id="demo-vehicle" data-category-id="1" data-resource-kind="vehicle">
    <summary>
        <span class="resource-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="m6 13 3-6h14l3 6M5 13h22v12H5zM9 25v3m14-3v3M9 18h2m10 0h2" /></svg></span>
        <span class="resource-description"><strong>Valtra n175</strong><span data-resource-info>Kjøretøy · Førerkort kl. T</span><span class="resource-availability">Tilgjengelig <i class="available" aria-hidden="true"></i></span></span>
        <span class="resource-toggle"><span class="when-closed">Endre ↓</span><span class="when-open">Lukk ↑</span></span>
    </summary>
    <form class="resource-edit-form" data-resource-kind="vehicle" data-demo-edit novalidate>
        <input name="ResourceId" type="hidden" value="demo-vehicle" />
        <input name="CategoryId" type="hidden" value="1" />
        <div class="resource-edit-grid">
            <div>
                <label>Navn / modell *<input name="Object" value="Valtra n175" maxlength="100" required /></label>
                <label>Har kjøretøyet registreringsnummer?<select name="HasRegistrationNumber"><option value="true" selected>Ja</option><option value="false">Nei</option></select></label>
                <label data-registration-number>Registreringsnummer<input name="RegistrationNumber" value="AB12345" maxlength="12" minlength="2" required /></label>
                <label>Påkrevd førerkortklasse<input name="RequiredLicense" value="T" maxlength="100" placeholder="Eks. B, BE, T" /></label>
                <label>Tilstand *<input name="Condition" value="God" maxlength="100" required /></label>
                <label>Ytterligere informasjon<textarea name="AdditionalInformation" maxlength="200" rows="4" placeholder="Kapasitet, begrensninger eller andre opplysninger"></textarea></label>
            </div>
            <div>
                <label>Telefon *<input name="Kontaktpunkt" type="tel" inputmode="tel" value="+47 900 12 345" maxlength="25" required /></label>
                <label>Tilgjengelighet *<select name="Available" required><option value="true" selected>Ja</option><option value="false" >Ikke akkurat nå</option></select></label>
                <label>Kan være tilgjengelig fra (valgfritt)<input name="TilgjengeligFra" type="datetime-local" /></label>
                <p class="wizard-hint">Datoen kan stå tom. Tilgjengeligheten bestemmes av valget over.</p>
            </div>
        </div>
        <section data-resource-address class="resource-edit-address" aria-label="Ressursens plassering">
            <label for="demo-vehicle-address">Adresse *<input id="demo-vehicle-address" name="Address" value="Rådhusgata 18, 4611 Kristiansand S" maxlength="250" autocomplete="street-address" aria-expanded="false" aria-controls="demo-vehicle-address-results" required /></label>
            <input name="Latitude" type="hidden" value="58.146700" />
            <input name="Longitude" type="hidden" value="7.995600" />
            <p class="wizard-hint">Eksempelplassering. Skriv en ny adresse og velg et forslag for å flytte ressursen. Søket sendes til Kartverket eller Photon/OpenStreetMap.</p>
            <p data-address-status class="wizard-hint" role="status"></p>
            <ul id="demo-vehicle-address-results" data-address-results class="wizard-address-results" aria-label="Adresseforslag" hidden></ul>
            <div data-address-map class="wizard-map" role="region" aria-label="Kart over ressursens plassering"></div>
        </section>
        <p class="resource-edit-status" role="status" aria-live="polite"></p>
        <div class="resource-edit-actions">
            <button type="button" class="resource-delete" data-demo-delete>Slett ressurs</button>
            <button type="button" class="resource-cancel" data-resource-cancel>Avbryt</button>
            <button type="submit" class="overview-button">Lagre endringer</button>
        </div>
    </form>
</details>
