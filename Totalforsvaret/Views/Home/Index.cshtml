@model Totalforsvaret.Models.PublicHomeViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Paratus – Hovedside</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/public-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/incident-alert.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-motion.css" asp-append-version="true" />
</head>
<body class="public-home">
    <header class="public-header">
        <nav class="public-nav" aria-label="Hovedmeny">
            <div class="public-nav-pages">
                <a class="active" aria-current="page" asp-area="" asp-controller="Home" asp-action="Index">Hovedside</a>
                <a href="#registrer-ressurs">Registrer ressurs</a>
            </div>
            <div class="public-nav-account">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.HasClaim("Brukertype", "Privat"))
                    {
                        <a class="nav-button nav-button-primary" asp-area="Privat" asp-controller="Dashboard" asp-action="Index">Min side</a>
                    }
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button class="nav-button nav-button-outline" type="submit">Logg ut</button>
                    </form>
                }
                else
                {
                    <a class="nav-button nav-button-primary" asp-area="" asp-controller="Account" asp-action="Login">Logg inn</a>
                    <a class="nav-button nav-button-outline" asp-area="" asp-controller="Account" asp-action="Register">Opprett bruker</a>
                }
            </div>
        </nav>
        <div class="public-section-bar" aria-hidden="true"></div>
    </header>

    <div class="public-video-hero" aria-hidden="true">
        <img class="public-hero-poster" src="https://i.ytimg.com/vi/pd6goYLB3Gs/maxresdefault.jpg" alt="" />
        <div class="public-hero-video" aria-hidden="true" inert>
            <iframe id="public-background-video"
                    data-video-src="https://www.youtube-nocookie.com/embed/pd6goYLB3Gs?autoplay=1&amp;mute=1&amp;loop=1&amp;playlist=pd6goYLB3Gs&amp;controls=0&amp;playsinline=1&amp;disablekb=1&amp;fs=0"
                    title="Lydløs bakgrunnsvideo"
                    allow="autoplay; encrypted-media"
                    referrerpolicy="strict-origin-when-cross-origin"
                    tabindex="-1"></iframe>
        </div>
    </div>

    <main class="public-content">
        <section class="public-action-cards" aria-label="Kom i gang">
            <article class="public-card">
                <details class="public-help">
                    <summary aria-label="Hjelp om innlogging">?</summary>
                    <p>Opprett en privat konto, eller logg inn med en konto du allerede har.</p>
                </details>
                <h2>Logg inn eller opprett en bruker</h2>
                <p class="public-card-description">Her kan du logge inn eller opprette brukeren din.</p>
                <div class="public-card-action">
                    <h3>Logg inn</h3>
                    <a class="public-button public-button-primary" asp-area="" asp-controller="Account" asp-action="Login">
                        <span>Innlogging</span><span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>
            <article class="public-card">
                <details class="public-help">
                    <summary aria-label="Hjelp om ressursregistrering">?</summary>
                    <p>Du skal kunne fylle ut ressursen først og logge inn eller opprette konto ved fullføring. Registreringen blir tilgjengelig senere.</p>
                </details>
                <h2>Registrer en ressurs</h2>
                <p class="public-card-description">Her vil du kunne starte en ressursregistrering uten å logge inn først.</p>
                <div class="public-card-action">
                    <h3>Registrering</h3>
                    <a class="public-button public-button-outline" href="#registrer-ressurs">
                        <span>Start registrering</span><span aria-hidden="true">↓</span>
                    </a>
                </div>
            </article>
        </section>

        <div class="public-home-incident">
            <partial name="/Views/Shared/_IncidentAlert.cshtml" />
        </div>

        <section id="registrer-ressurs" class="public-registration" aria-labelledby="registration-title">
            <div class="public-registration-intro">
                <h2 id="registration-title">Registrer en ressurs til disposisjon</h2>
                <p>Har du utstyr, kjøretøy eller andre ressurser du kan stille til rådighet?</p>
            </div>
            <div class="public-resource-card">
                <details class="public-help">
                    <summary aria-label="Hjelp om ressurstyper">?</summary>
                    <p>Velg kategorien som passer ressursen din. Selve registreringsskjemaet kommer senere.</p>
                </details>
                <div class="public-resource-description">
                    <h3>Hva ønsker du å registrere?</h3>
                    <p>Her kan du velge hvilken type ressurs du ønsker å stille til rådighet.</p>
                </div>
                @* Klargjort for registrering uten innlogging. Ingen innsending før gjesteflyten er implementert. *@
                <div class="public-resource-form">
                    <label for="public-category">Velg en ressurstype</label>
                    <select id="public-category" aria-describedby="public-registration-status">
                        <option value="" disabled selected>Ressurstype</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Value">@category.Text</option>
                        }
                    </select>
                    <p id="public-registration-status" class="public-login-note">Registreringen blir tilgjengelig senere. Ingenting sendes inn her ennå.</p>
                </div>
            </div>
        </section>
    </main>

    <footer class="public-footer">
        <div class="public-footer-content">
            <h2>Tusen takk for din hjelp</h2>
            <p>Vi ønsker å rette en stor takk til alle som bidrar til å styrke vår felles beredskap. Enten du stiller ressurser til disposisjon, deler viktig informasjon eller på andre måter engasjerer deg, er ditt bidrag verdifullt.</p>
            <p>God beredskap handler om samarbeid, tillit og viljen til å stille opp for hverandre. Ved å samle mennesker, organisasjoner og tilgjengelige ressurser på ett sted, legger vi til rette for bedre samhandling og raskere respons når det virkelig gjelder.<br />Sammen kan vi skape et tryggere, sterkere og mer forberedt samfunn.</p>
        </div>
        <div class="public-footer-bottom">
            <span>Paratus</span>
            <div class="public-footer-links">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Personvern</a>
                <span aria-hidden="true">·</span><span>Tilgjengelighet</span>
                <span aria-hidden="true">·</span><span>Kontakt</span>
            </div>
        </div>
    </footer>
    <script src="~/js/public-home.js" asp-append-version="true"></script>
</body>
</html>


