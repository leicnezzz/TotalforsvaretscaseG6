@model Totalforsvaret.Models.RegisterInput

@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Opprett bruker";
}

<section class="account-card"
         aria-labelledby="register-title">
    <h2 id="register-title">Opprett bruker</h2>
    <p class="account-intro">Opprett en ny privat bruker.</p>

    @if (ViewData["FormError"] is string error)
    {
        <p class="account-message account-error" role="alert">
            @error
        </p>
    }

    <form asp-area=""
          asp-controller="Account"
          asp-action="Register"
          method="post">
        <div class="account-name-row">
            <div class="account-field">
                <label asp-for="FirstName">Fornavn</label>

                <div class="account-input">
                    <input asp-for="FirstName"
                           autocomplete="given-name"
                           maxlength="100"
                           placeholder="Skriv inn fornavn"
                           required />
                </div>

                <span asp-validation-for="FirstName"
                      class="account-validation"></span>
            </div>

            <div class="account-field">
                <label asp-for="LastName">Etternavn</label>

                <div class="account-input">
                    <input asp-for="LastName"
                           autocomplete="family-name"
                           maxlength="100"
                           placeholder="Skriv inn etternavn"
                           required />
                </div>

                <span asp-validation-for="LastName"
                      class="account-validation"></span>
            </div>
        </div>

        <div class="account-field">
            <label asp-for="Email">E-post</label>

            <div class="account-input">
                <svg class="account-field-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.4"
                     aria-hidden="true">
                    <circle cx="12" cy="7" r="4" />
                    <path d="M4 22v-2a8 8 0 0 1 16 0v2" />
                </svg>

                <input asp-for="Email"
                       type="email"
                       autocomplete="username"
                       maxlength="254"
                       placeholder="Skriv inn e-post"
                       required />
            </div>

            <span asp-validation-for="Email"
                  class="account-validation"></span>
        </div>

        <div class="account-field">
            <label asp-for="Password">Passord</label>

            <div class="account-input">
                <svg class="account-field-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.4"
                     aria-hidden="true">
                    <rect x="5" y="10" width="14" height="11" rx="2" />
                    <path d="M8 10V6a4 4 0 0 1 8 0v4" />
                </svg>

                <input asp-for="Password"
                       type="password"
                       autocomplete="new-password"
                       minlength="12"
                       aria-describedby="password-help"
                       placeholder="Skriv inn passord"
                       required />

                <button class="account-password-toggle"
                        type="button"
                        data-password-toggle
                        aria-controls="Password"
                        aria-label="Vis passord"
                        aria-pressed="false">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5"
                         aria-hidden="true">
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>

            <span asp-validation-for="Password"
                  class="account-validation"></span>

            <p id="password-help" class="account-help">
                Minst 12 tegn, med både bokstaver og tall.
            </p>
        </div>

        <div class="account-field">
            <label asp-for="ConfirmPassword">Gjenta passord</label>

            <div class="account-input">
                <svg class="account-field-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.4"
                     aria-hidden="true">
                    <rect x="5" y="10" width="14" height="11" rx="2" />
                    <path d="M8 10V6a4 4 0 0 1 8 0v4" />
                </svg>

                <input asp-for="ConfirmPassword"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Gjenta passordet"
                       required />

                <button class="account-password-toggle"
                        type="button"
                        data-password-toggle
                        aria-controls="ConfirmPassword"
                        aria-label="Vis passord"
                        aria-pressed="false">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5"
                         aria-hidden="true">
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>

            <span asp-validation-for="ConfirmPassword"
                  class="account-validation"></span>
        </div>

        <button class="account-submit" type="submit">
            Opprett bruker
        </button>

        <div class="account-links">
            <a asp-area=""
               asp-controller="Account"
               asp-action="Login">
                Har du allerede en konto? Logg inn
            </a>
        </div>
    </form>
</section>