@model Totalforsvaret.Models.Inbox.InboxViewModel
@using Totalforsvaret.Areas.Offentlig.Models

@{
    Layout = null;
    ViewData["PrivateSection"] = "Innboks";
    ViewData["PrivateBack"] = false;
}

<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Innboks – Paratus</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/Private-home.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site-header.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Inbox.css"
          asp-append-version="true" />
</head>

<body class="private-home inbox-page">
    <partial name="/Areas/Privat/Views/Shared/_PrivateNavigation.cshtml" />

    <main class="inbox-main">
        <a class="inbox-back"
           asp-area="Privat"
           asp-controller="Dashboard"
           asp-action="Index">
            <span aria-hidden="true">←</span>
            Tilbake
        </a>

        <partial name="~/Areas/Shared/Views/Shared/_InboxCard.cshtml"
                 model="Model" />
    </main>

    <footer class="inbox-footer">
        <span>Paratus</span>

        <nav aria-label="Bunnmeny">
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Personvern
            </a>

            <span aria-hidden="true">·</span>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Contact">
                Kontakt
            </a>
        </nav>
    </footer>
</body>
</html>