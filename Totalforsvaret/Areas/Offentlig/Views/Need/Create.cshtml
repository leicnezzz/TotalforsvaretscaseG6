
@model Totalforsvaret.Areas.Offentlig.ViewModels.NeedCreateViewModel

@{
    ViewData["Title"] = ViewData["EditId"] != null
        ? "Endre behov"
        : "Registrer behov";
}

<div class="container py-4">
    <h1>@ViewData["Title"]</h1>
    <p>Registrer et ressursbehov og velg plasseringen på kartet.</p>

    <form asp-area="Offentlig"
          asp-controller="Need"
          asp-action="@(ViewData["EditId"] != null ? "Edit" : "Create")"
          asp-route-id="@(ViewData["EditId"])"
          method="post">

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Navn på behovet</label>
            <input asp-for="Name" class="form-control"
                   placeholder="For eksempel Behov for transport"
                   maxlength="100" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CrisisId" class="form-label">Tilknyttet krise</label>
            <select asp-for="CrisisId" asp-items="Model.Crises"
                    class="form-select">
                <option value="">Velg krise</option>
            </select>
            <span asp-validation-for="CrisisId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">Type behov</label>
            <select asp-for="Type" class="form-select">
                <option value="">Velg type</option>
                <option value="Personell">Personell</option>
                <option value="Utstyr">Utstyr</option>
                <option value="Transport">Transport</option>
                <option value="Mat og vann">Mat og vann</option>
                <option value="Medisinsk hjelp">Medisinsk hjelp</option>
                <option value="Annet">Annet</option>
            </select>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Priority" class="form-label">Prioritet</label>
            <select asp-for="Priority" class="form-select">
                <option value="">Velg prioritet</option>
                <option value="Lav">Lav</option>
                <option value="Middels">Middels</option>
                <option value="Høy">Høy</option>
                <option value="Kritisk">Kritisk</option>
            </select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="">Velg status</option>
                <option value="Åpen">Åpen</option>
                <option value="Under behandling">Under behandling</option>
                <option value="Løst">Løst</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Beskrivelse</label>
            <textarea asp-for="Description" class="form-control"
                      rows="4" maxlength="1500"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Velg plassering på kartet.</label>
            <p class="text-muted">Klikk på kartet for å plassere behovet.</p>

            <div id="map" style="height: 450px; width: 100%;"></div>

            <input asp-for="Latitude" type="hidden" id="Latitude" />
            <input asp-for="Longitude" type="hidden" id="Longitude" />

            <span asp-validation-for="Latitude" class="text-danger"></span>
            <span asp-validation-for="Longitude" class="text-danger"></span>

            <p id="coordinates" class="text-muted mt-2">
                Ingen plassering valgt.
            </p>
        </div>

        <button type="submit" class="btn btn-success">
            @(ViewData["EditId"] != null ? "Endre behov" : "Registrer behov")
        </button>

        <a asp-area=""
           asp-controller="OffentligAktor"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Avbryt
        </a>
    </form>

    @if (ViewData["EditId"] != null)
    {
        <form asp-area="Offentlig"
              asp-controller="Need"
              asp-action="Delete"
              asp-route-id="@(ViewData["EditId"])"
              method="post"
              class="mt-3"
              onsubmit="return confirm('Er du sikker på at du vil slette hele dette behovet? Det fjernes også fra aktive behov og kartet. Dette kan ikke angres.');">

            <button type="submit" class="btn btn-danger">
                Slett behov
            </button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const map = L.map('map').setView([58.1467, 7.9956], 13);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        let marker = null;

        map.on('click', function (e) {
            const latitude = e.latlng.lat;
            const longitude = e.latlng.lng;

            if (marker) {
                marker.setLatLng(e.latlng);
            } else {
                marker = L.marker(e.latlng).addTo(map);
            }

            document.getElementById('Latitude').value = latitude;
            document.getElementById('Longitude').value = longitude;

            document.getElementById('coordinates').textContent =
                'Valgt plassering: ' +
                latitude.toFixed(5) + ', ' +
                longitude.toFixed(5);
        });
    </script>
}
