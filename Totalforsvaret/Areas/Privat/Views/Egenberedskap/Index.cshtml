@{
    ViewData["Title"] = "Egenberedskap";
    Layout = null;
}

<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] – Totalforsvaret</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site-header.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/egenberedskap.css"
          asp-append-version="true" />
</head>
<body>
    <partial name="/Areas/Privat/Views/Shared/_PrivateNavigation.cshtml" />

    <main class="beredskap-container">
        <header class="page-header">
            <h1>Oversikt over egen beredskap</h1>
            <p>For deg som ønsker å bli en bedre ressurs for samfunnet.</p>
        </header>

        <section class="checklist-section" aria-labelledby="checklist-title">
            <h2 id="checklist-title">Sjekkliste for beredskap</h2>

            <div class="checklist-grid">
                <article class="preparedness-card">
                    <h3>Mat og vann</h3>
                    <ul>
                        <li>Rent drikkevann lagret på kanner eller flasker</li>
                        <li>Mat som tåler lagring i romtemperatur</li>
                        <li>Grill, kokeapparat eller stormkjøkken</li>
                        <li>Ekstra gassbeholder eller brennstoff</li>
                        <li>Mat og vann til kjæledyr</li>
                        <li>Litt kontanter og flere betalingskort</li>
                    </ul>
                </article>

                <article class="preparedness-card">
                    <h3>Varme og lys</h3>
                    <ul>
                        <li>Varme klær og pledd</li>
                        <li>Fyrstikker eller stearinlys</li>
                        <li>Ved dersom du har peis</li>
                        <li>Gass- eller parafinovn</li>
                        <li>Avtale om overnatting</li>
                        <li>Lommelykter eller hodelykter</li>
                    </ul>
                </article>

                <article class="preparedness-card">
                    <h3>Informasjon</h3>
                    <ul>
                        <li>DAB-radio</li>
                        <li>Batterier og batteribank</li>
                        <li>Liste over viktige telefonnummer</li>
                    </ul>
                </article>

                <article class="preparedness-card">
                    <h3>Legemidler og hygiene</h3>
                    <ul>
                        <li>Legemidler og førstehjelpsutstyr</li>
                        <li>Jodtabletter</li>
                        <li>Hygieneartikler</li>
                    </ul>
                </article>
            </div>
        </section>

        <section class="courses-section" aria-labelledby="courses-title">
            <h2 id="courses-title">Oversikt over diverse kurs</h2>

            <div class="courses-grid">
                <article class="preparedness-card">
                    <h3>Norske Luftambulanse</h3>
                    <ul>
                        <li>CPR</li>
                        <li>Hjertestarter</li>
                        <li>Førstehjelp for barn</li>
                        <li>Gjenkjenne slag</li>
                        <li>Akutte situasjoner</li>
                    </ul>
                </article>

                <article class="preparedness-card">
                    <h3>Røde Kors</h3>
                    <ul>
                        <li>Førstehjelp grunnkurs</li>
                        <li>Førstehjelp ved ulykker</li>
                        <li>Psykisk førstehjelp</li>
                        <li>Frivillig akuttberedskap</li>
                    </ul>
                </article>

                <article class="preparedness-card">
                    <h3>Brannvernforeningen</h3>
                    <ul>
                        <li>Brannforebygging</li>
                        <li>Slukkeutstyr</li>
                        <li>Evakueringsrutiner</li>
                    </ul>
                </article>
            </div>
        </section>
    </main>
</body>
</html>