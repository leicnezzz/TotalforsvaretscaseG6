@model Totalforsvaret.Areas.Privat.Models.ProfileViewModel

@{
    ViewData["Title"] = "Min profil";
}


<main class="profile-page">
    <header class="profile-page__header">
        <p class="profile-page__eyebrow">Privat aktør</p>
        <h1>Min profil</h1>
        <p>Se og oppdater kontaktinformasjonen din.</p>
    </header>

    @if (TempData["ProfileSaved"] is string message)
    {
        <div class="profile-message" role="status">@message</div>
    }

    <section class="profile-card" aria-labelledby="profile-details-heading">
        <div class="profile-card__heading">
            <div class="profile-avatar" aria-hidden="true">
                @GetInitials(Model.Navn)
            </div>
            <div>
                <h2 id="profile-details-heading">Kontoinformasjon</h2>
                <p>Oppdater navn og telefonnummer.</p>
            </div>
        </div>

        <form asp-area="Privat"
              asp-controller="Profile"
              asp-action="Index"
              method="post"
              class="profile-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="profile-validation"
                 role="alert"></div>

            <div class="profile-field">
                <label asp-for="Navn"></label>
                <input asp-for="Navn" autocomplete="name" />
                <span asp-validation-for="Navn" class="profile-field__error"></span>
            </div>

            <div class="profile-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" readonly aria-describedby="email-help" />
                <small id="email-help">Kontakt kundestøtte hvis e-postadressen må endres.</small>
            </div>

            <div class="profile-field">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="profile-field__error"></span>
            </div>

            <div class="profile-actions">
                <button type="submit" class="button button--primary">Lagre endringer</button>
            </div>
        </form>
    </section>

    <section class="profile-card profile-security" aria-labelledby="security-heading">
        <div>
            <h2 id="security-heading">Sikkerhet</h2>
            <p>Passordet endres på en egen, sikker side.</p>
        </div>

        <a class="button button--secondary"
           asp-area="Identity"
           asp-page="/Account/Manage/ChangePassword">
            Endre passord
        </a>
    </section>
</main>

@functions {
    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        return string.Join("", name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
    }
}