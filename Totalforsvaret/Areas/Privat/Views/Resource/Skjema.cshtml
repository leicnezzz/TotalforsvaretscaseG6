@model Totalforsvaret.Areas.Privat.Models.FormDataModel
@{
    Layout = null;
    ViewData["PrivateSection"] = "Ressursregistrering";
    ViewData["PrivateBack"] = true;
    var navn = User.Identity?.Name ?? "Min konto";
    var initialer = string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(del => char.ToUpperInvariant(del[0])));
}
<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registrer ressurs – Paratus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/private-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/incident-alert.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-motion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/resource-registration.css" asp-append-version="true" />
</head>
<body class="private-home resource-registration">
    <header class="site-header">
        <nav class="primary-nav" aria-label="Hovedmeny">
            <div class="nav-links">
                <a

                   asp-area="Privat"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    Min side
                </a>

                <a asp-area="Privat"
                   asp-controller="Resource"
                   asp-action="Skjema" class="active" aria-current="page">
                    Ressursregistrering
                </a>

                <a asp-area="Privat"
                   asp-controller="Resource"
                   asp-action="Oversikt">
                    Mine ressurser
                </a>
            </div>

            <div class="profile">
                <svg class="bell"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" />
                    <path d="M10 21h4" />
                </svg>

                <span class="avatar avatar-small" aria-hidden="true">
                    @initialer
                </span>

                <span class="profile-name">@navn</span>
            </div>
        </nav>

        <partial name="/Views/Shared/_PrivateBreadcrumb.cshtml" />
    </header>
    <partial name="/Views/Shared/_PrivatePageAction.cshtml" />
    <main class="registration-main">
        <div class="registration-content">
            <partial name="/Views/Shared/_IncidentAlert.cshtml" />
            <section class="registration-intro" aria-labelledby="registration-title">
                <h1 id="registration-title">Registrere en ressurs til disposisjon</h1>
                <p>Registrer kjøretøy, utstyr eller andre ressurser som kan bidra i en beredskapssituasjon.</p>
            </section>
            <section class="registration-category" aria-labelledby="category-title">
                <details class="registration-help">
                    <summary aria-label="Hjelp til valg av ressurstype">?</summary>
                    <p>Velg kategorien som passer ressursen du ønsker å stille til rådighet.</p>
                </details>
                <div>
                    <h2 id="category-title">Hva ønsker du å registrere?</h2>
                    <p>Her kan du velge hvilken type ressurs du ønsker å stille til rådighet.</p>
                </div>
                <div class="registration-category-field">
                    <label for="CategoryId">Velg en ressurstype</label>
                    <div class="registration-select">
                        <select asp-for="CategoryId" aria-describedby="category-preview-note">
                            <option value="">Ressurstype</option>
                            @foreach (var category in Model.Categories)
                            {
                                var label = category.Text switch { "Vehicles" => "Kjøretøy", "Food" => "Mat", "Equipment" => "Utstyr", _ => category.Text };
                                <option value="@category.Value">@label</option>
                            }
                        </select>
                        <span aria-hidden="true">⌄</span>
                    </div>
                    <span id="category-preview-note" class="registration-sr-only">Foreløpig vises kun kategorivalget. Flere registreringssteg kommer senere.</span>
                </div>
            </section>
        </div>
    </main>
    <footer class="registration-footer">
        <span>Paratus</span>
        <div>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Personvern</a>
            <span aria-hidden="true">·</span><span>Tilgjengelighet</span>
            <span aria-hidden="true">·</span><span>Kontakt</span>
        </div>
    </footer>
</body>
</html>