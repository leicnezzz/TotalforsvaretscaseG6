@using Totalforsvaret.Models.resourcemodels
@using System.Text.Json
@using Totalforsvaret.Areas.Offentlig.Models
@model List<Resource>

@{
    var isMatch = ViewContext.RouteData.Values["match"] is true;
    ViewData["Title"] = isMatch ? "Match" : "Operativ oversikt";
    ViewData["FullWidth"] = true;
    ViewData["RegistrationFooter"] = true;
    ViewData["HideFooter"] = !isMatch;

    // Sender bare opplysningene kartet trenger.
    var kartRessurser = Model.Select(ressurs => new
    {
        id = ressurs.ResourceId,
        kategoriId = ressurs.CategoryId,
        adresse = ressurs.Address,
        navn = ressurs.Object,
        kategori = ressurs.Category?.Name ?? "Uten kategori",
        tilbyder = ressurs.Navn,
        kontaktpunkt = ressurs.Kontaktpunkt,
        tilgjengeligFra = ressurs.TilgjengeligFra?.ToString("dd.MM.yyyy HH:mm"),
        latitude = ressurs.Latitude,
        longitude = ressurs.Longitude,
        egen = ressurs.BrukerId == (int?)ViewBag.MinBrukerId
    });

    var kartBehov = (ViewBag.BehovPaKart as IEnumerable<Need>
                     ?? Enumerable.Empty<Need>()).Select(behov => new
    {
        id = behov.Id,
        kriseId = behov.CrisisId,
        navn = behov.Name,
        type = behov.Type,
        prioritet = behov.Priority,
        status = behov.Status,
        beskrivelse = behov.Description,
        latitude = behov.Latitude,
        longitude = behov.Longitude
    });

    var kartJson = JsonSerializer.Serialize(new
    {
        ressurser = kartRessurser,
        behov = kartBehov,
        markeringer = (ViewBag.Kartmarkeringer as IEnumerable<Totalforsvaret.Models.CrisisMapAnnotation>
            ?? Enumerable.Empty<Totalforsvaret.Models.CrisisMapAnnotation>()).Select(a => new
            {
                id = a.Id, crisisId = a.CrisisId, kind = a.Kind, name = a.Name,
                description = a.Description, impact = a.Impact, risk = a.Risk,
                coordinates = JsonSerializer.Deserialize<double[][]>(a.CoordinatesJson)
            }),
        kriser = (object?)ViewBag.KriserPaKart ?? Array.Empty<object>()
    });

    var opptatteRessursIder = ViewBag.OpptatteRessursIder as HashSet<int> ?? new HashSet<int>();
    var listeRessurser = isMatch
        ? Model.Where(r => !opptatteRessursIder.Contains(r.ResourceId) &&
                           (r.TilgjengeligFra == null || r.TilgjengeligFra <= DateTime.Now))
        : Model;
    var oversiktJson = JsonSerializer.Serialize(new
    {
        kriser = (object?)ViewBag.KriserTilLister ?? Array.Empty<object>(),
        behov = (object?)ViewBag.BehovTilLister ?? Array.Empty<object>(),
        ressurser = listeRessurser.Select(r => new
        {
            id = r.ResourceId,
            navn = r.Object,
            kategoriId = r.CategoryId,
            kategori = r.Category?.Name,
            adresse = r.Address,
            tilbyder = r.Navn,
            kontaktpunkt = r.Kontaktpunkt,
            latitude = r.Latitude,
            longitude = r.Longitude
        })
    });
}

<link rel="stylesheet"
      href="~/css/offentlig-aktor.css"
      asp-append-version="true" />
<link rel="stylesheet" href="~/css/resource-registration.css" asp-append-version="true" />

<link rel="stylesheet" href="~/css/offentlig-match.css" asp-append-version="true" />
@if (isMatch)
{
    <link rel="stylesheet" href="~/css/offentlig-motion.css" asp-append-version="true" />
}

@if (!isMatch)
{
<div class="container-fluid offentlig-dashboard">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible" data-oversikt-varsel>
            <span role="status">@successMessage</span>
            <button type="button" class="btn-close" aria-label="Lukk varselet"></button>
        </div>
    }

    <details class="kart-oversiktsvalg" open>
        <summary aria-label="Vis eller skjul oversikten"><span aria-hidden="true"></span></summary>
        <div class="kart-oversiktsrad">
            <div class="kart-oversiktsgruppe">
            <div class="statistikk-rad">
                    <button type="button" class="stat-kort krise-kort"
                            aria-haspopup="dialog" aria-controls="oversiktDialog" data-oversikt-liste="kriser">
                        <span>Hendelser</span>
                        <span class="stat-tall">@((ViewBag.KriserTilLister as System.Collections.ICollection)?.Count ?? 0)</span>
                    </button>
                    <button type="button" class="stat-kort behov-kort"
                            aria-haspopup="dialog" aria-controls="oversiktDialog" data-oversikt-liste="aktive">
                        <span>Aktive behov</span>
                        <span class="stat-tall">@ViewBag.AktiveBehov</span>
                    </button>
                    <button type="button" class="stat-kort treff-kort"
                            aria-haspopup="dialog" aria-controls="oversiktDialog" data-oversikt-liste="treff">
                        <span>Foreslåtte treff</span>
                        <span class="stat-tall">@ViewBag.ForeslatteTreff</span>
                    </button>
                    <button type="button" class="stat-kort"
                            aria-haspopup="dialog" aria-controls="oversiktDialog" data-oversikt-liste="oppfolging">
                        <span>Krever oppfølging</span>
                        <span class="stat-tall">@((ViewBag.AktiveBehovListe as System.Collections.ICollection)?.Count ?? 0)</span>
                    </button>
                </div>
            </div>
            <div class="oversikt-handlinger">
                <a class="egen-ressurs-lenke" asp-area="" asp-controller="Home" asp-action="ResourceRegistration">Ny Ressurs</a>
                <a class="registrer-behov-knapp" asp-area="Offentlig" asp-controller="Need" asp-action="Create">+ Registrer behov</a>
                <a class="opprett-krise-knapp" asp-area="Offentlig" asp-controller="Crisis" asp-action="Create">+ Opprett hendelse</a>
            </div>
        </div>
    </details>

    <section class="kart-hendelser" aria-label="Hendelser i kartet">
        <div id="kartStart" class="kart-start" hidden>
            <h2>Åpne en hendelse for å gjøre endringer</h2>
            <p>Velg én eller flere hendelser på Hendelser-siden.</p>
            <a class="btn btn-primary" asp-route="crisis-overview">Gå til Hendelser</a>
        </div>
        <span id="kartArbeidsstatus" role="status"></span>
        <div id="kartAntiforgery" hidden>@Html.AntiForgeryToken()</div>
    </section>

    <!-- Kart og oppfølging -->
    <div class="row gx-3 offentlig-arbeidsflate">

        <div class="col-12">
            <section id="kart" class="situasjonskart" aria-label="Operativt kart">
                <div id="offentligKart">
                    @{ var bekreftelse = TempData["NeedSuccessMessage"] as string; }
                    <div class="kart-bekreftelse alert alert-success alert-dismissible" hidden="@(bekreftelse == null)">
                        <span class="kart-bekreftelsestekst" role="status">@bekreftelse</span>
                        <button class="btn-close" type="button" aria-label="Lukk bekreftelsen"></button>
                    </div>

                    <div class="kart-handlinger">
                        <div class="kart-handlingsrad" role="group" aria-label="Karthandlinger">
                            <button type="button" aria-expanded="false" aria-controls="kartVeihindring">Veihindring</button>
                            <button type="button" aria-expanded="false" aria-controls="kartSone">Soner</button>
                        </div>

                        <p id="kartVelgVeihindring" class="kart-plasseringshint" role="status"></p>

                        <section id="kartVeihindring" class="kart-handlingspanel" aria-labelledby="kartVeihindringTittel" hidden>
                            <h2 id="kartVeihindringTittel">Registrer veihindring</h2>
                            <p class="kart-panelintro">Marker en plassering i kartet. Markeringen lagres på valgt hendelse.</p>
                            <form data-kartmarkering="veihindringer">
                                <p class="kart-posisjon" role="status">Klikk i kartet for å velge plassering.</p>
                                <label for="kartHindringNavn">Type veihindring</label>
                                <input id="kartHindringNavn" name="navn" class="form-control" placeholder="For eksempel stengt vei" maxlength="100" required />
                                <label for="kartHindringBeskrivelse">Beskrivelse</label>
                                <textarea id="kartHindringBeskrivelse" name="beskrivelse" class="form-control" rows="2" maxlength="120"></textarea>
                                <fieldset class="kart-valgfelt">
                                    <legend>Påvirkning på fremkommelighet</legend>
                                    <div class="kart-piller">
                                        <label><input type="radio" name="pavirkning" value="Lav" /><span>Lav</span></label>
                                        <label><input type="radio" name="pavirkning" value="Moderat" checked /><span>Moderat</span></label>
                                        <label><input type="radio" name="pavirkning" value="Høy" /><span>Høy</span></label>
                                    </div>
                                </fieldset>
                                <div class="kart-panelknapper">
                                    <button class="btn btn-outline-secondary" type="button" data-kartavbryt>Avbryt</button>
                                    <button class="btn btn-primary" type="submit" disabled>Lagre veihindring</button>
                                </div>
                            </form>
                        </section>

                        <section id="kartSone" class="kart-handlingspanel" aria-labelledby="kartSoneTittel" hidden>
                            <h2 id="kartSoneTittel">Registrer sonemarkering</h2>
                            <p class="kart-panelintro">Klikk på minst tre ulike punkter i kartet for å tegne en sone. Bruk «Angre siste hjørne» for å korrigere et feilklikk.</p>
                            <form data-kartmarkering="soner">
                                <label for="kartSoneNavn">Navn</label>
                                <input id="kartSoneNavn" name="navn" class="form-control"
                                       placeholder="Skriv navnet som skal vises i kartet" maxlength="100" required />
                                <fieldset class="kart-sonevalg">
                                    <legend>Velg farge og risikonivå</legend>
                                    <label class="kart-sonevalg-lav">
                                        <input type="radio" name="risiko" value="lav" checked />
                                        <span class="kart-soneproeve" aria-hidden="true"></span>
                                        <span><strong>Grønn · Lav risiko</strong><br />Området trenger normal oppfølging.</span>
                                    </label>
                                    <label class="kart-sonevalg-moderat">
                                        <input type="radio" name="risiko" value="moderat" />
                                        <span class="kart-soneproeve" aria-hidden="true"></span>
                                        <span><strong>Gul · Moderat risiko</strong><br />Området trenger ekstra oppmerksomhet.</span>
                                    </label>
                                    <label class="kart-sonevalg-hoy">
                                        <input type="radio" name="risiko" value="hoy" />
                                        <span class="kart-soneproeve" aria-hidden="true"></span>
                                        <span><strong>Rød · Høy risiko</strong><br />Området trenger rask oppfølging.</span>
                                    </label>
                                </fieldset>
                                <p class="kart-posisjon" role="status">Klikk minst tre hjørner langs kanten av sonen.</p>
                                <div class="kart-panelknapper">
                                    <button class="btn btn-outline-secondary" type="button" data-angre-hjorne disabled>Angre siste hjørne</button>
                                    <button class="btn btn-outline-secondary" type="button" data-kartavbryt>Avbryt</button>
                                    <button class="btn btn-primary" type="submit" disabled>Godta sone</button>
                                </div>
                            </form>
                        </section>
                    </div>
                </div>

                <div class="kart-bunnrad">
                    <div class="kart-forklaring" aria-label="Forklaring av kartsymboler">
                        <span>
                            <span class="kart-tegn kart-tegn-ressurs" aria-hidden="true"></span>
                            Tilgjengelige ressurser
                        </span>

                        <span>
                            <span class="kart-tegn kart-tegn-behov" aria-hidden="true"></span>
                            Aktive behov
                        </span>

                        <span>
                            <span class="kart-tegn kart-tegn-krise" aria-hidden="true"></span>
                            Aktive hendelser
                        </span>

                        <span>
                            <img class="kart-forklaring-veihindring"
                                 src="@Url.Content("~/images/kart-veihindring.svg")"
                                 alt="" aria-hidden="true" />
                            Veihindringer
                        </span>

                        <span>
                            <span class="kart-tegn kart-tegn-sone" aria-hidden="true"></span>
                            Soner
                        </span>
                    </div>
                    <div class="kart-bunnhandlinger">
                        <a class="btn btn-outline-danger" data-lukk-hendelser hidden
                           asp-area="" asp-controller="OffentligAktor" asp-action="Index">Forlat krise</a>
                        <a class="skriv-ut-knapp"
                           asp-area=""
                           asp-controller="OffentligAktor"
                           asp-action="MineRessurser">
                            Mine ressurser
                        </a>
                        <div class="dropdown">
                            <button type="button"
                                    class="skriv-ut-knapp dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                Skriv ut
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button type="button"
                                            class="dropdown-item"
                                            data-utskrift="ressurser">
                                        Ressursliste
                                    </button>
                                </li>
                                <li>
                                    <button type="button"
                                            class="dropdown-item"
                                            data-utskrift="behov">
                                        Aktive behov
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button"
                                            class="dropdown-item"
                                            data-eksport="geojson">
                                        Last ned GeoJSON
                                    </button>
                                </li>
                            </ul>
                        </div>

                    </div>
                </div>
                <p id="kartmelding" class="visually-hidden" role="status"></p>
            </section>
        </div>
    </div>

    <dialog id="oversiktDialog"
            class="oversikt-dialog"
            aria-labelledby="oversiktListeTittel"
            data-hendelsesoversikt="@Url.RouteUrl("crisis-overview")"
            data-endre-behov="@Url.Action("Edit", "Need", new { area = "Offentlig" })">

        <div class="oversikt-dialogtopp">
            <h2 id="oversiktListeTittel">Aktive behov</h2>

            <button id="oversiktLukk"
                    type="button"
                    class="btn btn-outline-secondary">
                Lukk
            </button>
        </div>

        <div class="oversikt-filtre">
            <label for="oversiktType">
                Type
                <select id="oversiktType" class="form-select"></select>
            </label>

            <label for="oversiktSortering">
                Sortering
                <select id="oversiktSortering"
                        class="form-select"></select>
            </label>
        </div>

        <p id="oversiktAntall"
           class="oversikt-antall"
           role="status"
           aria-live="polite"></p>

        <div id="oversiktListe" class="oversikt-tabellomrade"></div>
        <div class="oversikt-tabellomrade pt-3" data-oversikt-panel="oppfolging" hidden>


            @if (ViewBag.AktiveBehovListe != null &&
                 ViewBag.AktiveBehovListe.Count > 0)
            {
                @foreach (var behov in ViewBag.AktiveBehovListe)
                {
                    <div class="oppfolging-kort" data-prioritet="@behov.Priority">
                        <strong>@behov.Name</strong>
                        <p>Type: @behov.Type</p>
                        <p>Prioritet: @behov.Priority</p>
                        <p>Status: @behov.Status</p>

                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-area="Offentlig"
                               asp-controller="Need"
                               asp-action="Edit"
                               asp-route-id="@behov.Id">
                                Endre behov
                            </a>

                            @if (behov.CrisisId != null)
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-area="Offentlig"
                                   asp-controller="Crisis"
                                   asp-action="Edit"
                                   asp-route-id="@behov.CrisisId">
                                    Endre tilhørende krise
                                </a>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Ingen aktive behov registrert.</p>
            }
        </div>
        <div class="oversikt-tabellomrade pt-3" data-oversikt-panel="treff" hidden>


            @{
                var kategorier = Model.ToDictionary(r => r.ResourceId, r => r.Category?.Name);
                var matchForslag = ViewBag.MatchForslag as
                                       List<Totalforsvaret.Areas.Offentlig.ViewModels.MatchSuggestionViewModel>
                                   ?? new();
                var aktiveTildelinger = ViewBag.AktiveTildelinger as
                                            List<Totalforsvaret.Areas.Offentlig.Models.ResourceAssignment>
                                        ?? new();
            }

            @if (matchForslag.Count > 0)
            {
                <p class="mb-3">
                    Kategoribaserte forslag som må vurderes før tildeling.
                </p>

                <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                    <label>
                        Søk
                        <input type="search" class="form-control" data-treff-sok placeholder="Søk på ressurs eller behov" />
                    </label>
                    <label>
                        Ressurstype
                        <select class="form-select" data-treff-type>
                            <option value="">Alle</option>
                            <option value="Vehicles">Kjøretøy</option>
                            <option value="Equipment">Utstyr</option>
                        </select>
                    </label>
                </div>
                <p data-treff-tom role="status" hidden>Ingen treff med disse filtrene.</p>

                @foreach (var treff in matchForslag)
                {
                    var tildeling = aktiveTildelinger.FirstOrDefault(a =>
                        a.NeedId == treff.NeedId &&
                        a.ResourceId == treff.ResourceId);
                    var ressursOpptatt = aktiveTildelinger.Any(a =>
                        a.ResourceId == treff.ResourceId);
                    <div class="oppfolging-kort" data-treff-rad data-treff-type="@kategorier.GetValueOrDefault(treff.ResourceId)"
                         data-treff-sok="@treff.ResourceName @treff.NeedName">
                        <strong>@treff.NeedName</strong>
                        <p>Ressurs: @treff.ResourceName</p>

                        @if (treff.DistanceKm.HasValue)
                        {
                            <p>
                                Luftlinje:
                                @(treff.DistanceKm.Value.ToString("0.0")) km
                            </p>
                        }
                        else
                        {
                            <p>Avstand ikke tilgjengelig.</p>
                        }


                        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                            @if (tildeling?.Status == Totalforsvaret.Areas.Offentlig.Models.AssignmentStatus.Requested)
                            {
                                <span class="status-merkelapp status-vurderes">
                                    Status: Til vurdering
                                </span>
                                <div class="knapperad">
                                <form asp-area=""
                                      asp-controller="OffentligAktor"
                                      asp-action="TildelRessurs"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="assignmentId"
                                           value="@tildeling.Id"/>

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-primary">
                                        Tildel ressurs
                                    </button>
                                </form>

                                <form asp-area=""
                                      asp-controller="OffentligAktor"
                                      asp-action="AvslaRessurs"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="assignmentId"
                                           value="@tildeling.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="return confirm('Avslå denne ressursen?');">
                                        Avslå ressurs
                                    </button>
                                </form>
                                </div>

                            }

                            @if (tildeling?.Status ==
                                 Totalforsvaret.Areas.Offentlig.Models.AssignmentStatus.Assigned)
                            {
                                <span class="status-merkelapp status-tildelt">
                                    Status: Tildelt
                                </span>

                                <form asp-area=""
                                      asp-controller="OffentligAktor"
                                      asp-action="FrigiRessurs"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="assignmentId"
                                           value="@tildeling.Id" />

                                    <button type="submit"
                                             class="btn btn-sm btn-outline-primary"
                                             onclick="return confirm('Frigi denne ressursen?');">
                                        Frigi ressurs
                                    </button>
                                </form>

                            }

                            @if (tildeling == null && !ressursOpptatt)
                            {
                                <form asp-area=""
                                      asp-controller="OffentligAktor"
                                      asp-action="VurderRessurs"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="needId"
                                           value="@treff.NeedId"/>

                                    <input type="hidden"
                                           name="resourceId"
                                           value="@treff.ResourceId"/>

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-primary">
                                        Vurder ressurs
                                    </button>
                                </form>
                            }

                            <a class="btn btn-sm btn-outline-primary"
                               asp-area="Offentlig"
                               asp-controller="Need"
                               asp-action="Edit"
                               asp-route-id="@treff.NeedId">
                                Se og endre behov
                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <p>
                    Ingen forslag funnet. Forslag krever et aktivt behov
                    og en tilgjengelig ressurs i tilsvarende kategori.
                </p>
            }
        </div>
    </dialog>
    <!-- Ressursliste som bare vises ved utskrift -->
    <section class="print-bare print-ressurser" aria-label="Ressursliste for utskrift">
        <h1>Ressursliste – Kristiansand kommune</h1>
        <p>Utskrift: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>

        <table class="print-tabell">
            <thead>
            <tr>
                <th>Ressurs</th>
                <th>Kategori</th>
                <th>Tilbyder</th>
                <th>Kontakt</th>
                <th>Tilgjengelig fra</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Object</td>
                    <td>@(r.Category?.Name ?? "Uten kategori")</td>
                    <td>@r.Navn</td>
                    <td>@r.Kontaktpunkt</td>
                    <td>@(r.TilgjengeligFra?.ToString("dd.MM.yyyy HH:mm") ?? "Ikke oppgitt")</td>
                </tr>
            }
            </tbody>
        </table>
    </section>
    <!-- Aktive behov som bare vises ved utskrift -->
    <section class="print-bare print-behov" aria-label="Aktive behov for utskrift">
        <h1>Aktive behov – Kristiansand kommune</h1>
        <p>Utskrift: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>

        <table class="print-tabell">
            <thead>
            <tr>
                <th>Behov</th>
                <th>Type</th>
                <th>Prioritet</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var b in (ViewBag.BehovPaKart as IEnumerable<Need>) ?? Enumerable.Empty<Need>())
            {
                <tr>
                    <td>@b.Name</td>
                    <td>@b.Type</td>
                    <td>@b.Priority</td>
                    <td>@b.Status</td>
                </tr>
            }
            </tbody>
        </table>
    </section>

</div>
}
else
{
    <partial name="_Match" />
}

@section Scripts {
    @if (isMatch)
    {
        <script src="~/js/offentlig-match.js" asp-append-version="true" defer></script>
    }
    <script id="offentligKartData" type="application/json">
        @Html.Raw(kartJson)
    </script>

    <script id="oversiktListeData" type="application/json">
