@using System.Collections.Generic

@{
    ViewData["Title"] = "Egenberedskap";
    Layout = null;
    ViewData["PrivateSection"] = "Egenberedskap";
    ViewData["PrivateBack"] = true;

    var completedItems =
        ViewData["CompletedChecklistItems"] as HashSet<string>
        ?? new HashSet<string>();
}

<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] – Totalforsvaret</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

   <link rel="stylesheet"
      href="~/css/Private-home.css"
      asp-append-version="true" />
<link rel="stylesheet"
      href="~/css/site-header.css"
      asp-append-version="true" />
<link rel="stylesheet"
      href="~/css/egenberedskap.css"
      asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
</head>
<body>
   <partial name="/Areas/Privat/Views/Shared/_PrivateNavigation.cshtml" />
   <partial name="/Areas/Homepage/Views/Shared/_PrivatePageAction.cshtml" />

    <main>
    <div class="beredskap-container">
        <header class="page-header">
            <h1>Oversikt over egen beredskap</h1>
            <p>For deg som ønsker å bli en bedre ressurs for samfunnet.</p>
        </header>

        <nav class="contents-card" aria-label="Innhold på siden">
            <h2>Innhold</h2>
            <p>Her er en oversikt over informasjon du finner på denne siden.</p>
            <a href="#tilfluktsrom">— &nbsp; Kart over offentlige tilfluktsrom</a>
            <a href="#checklist">— &nbsp; Sjekkliste for beredskap</a>
            <a href="#courses">— &nbsp; Oversikt over diverse kurs</a>
        </nav>
        <section id="tilfluktsrom" class="shelter-section" aria-labelledby="tilfluktsrom-tittel">
            <header class="section-heading">
                <h2 id="tilfluktsrom-tittel">Finn nærmeste offentlige tilfluktsrom</h2>
            </header>
            <div class="shelter-search">
                <ol class="shelter-instructions">
    <li>Skriv inn gatenavn og husnummer. Velg riktig adresse blant forslagene.</li>
    <li>Trykk <strong>Søk</strong>. Hvis du får flere treff, velg riktig adresse.</li>
    <li>Se de nærmeste tilfluktsrommene under kartet.
       Trykk på en adresse i tabellen for å se tilfluktsrommet på kartet.</li>
</ol>

              <form id="tilfluktsrom-sok">
    <label for="tilfluktsrom-adresse">Adresse</label>
   <p id="tilfluktsrom-adresse-hjelp">Eksempel: Markens gate 12, 4611</p>

    <div class="shelter-search-controls">
        <input id="tilfluktsrom-adresse"
               name="adresse"
               type="search"
               placeholder="Gatenavn, husnummer og ev. postnummer"
               aria-describedby="tilfluktsrom-adresse-hjelp"
               required disabled />
        <button type="submit" disabled>Søk</button>
    </div>

    <p id="tilfluktsrom-status" role="status"></p>
</form>
            </div>

<p id="tilfluktsrom-utskrift-adresse" class="shelter-print-address"></p>

            <ul id="tilfluktsrom-adressetreff"
                aria-label="Adresser som matcher søket"></ul>

            <div id="tilfluktsrom-kart"
                 role="region"
                 aria-label="Kart for tilfluktsrom"></div>

<div class="shelter-table-wrap">
<table class="shelter-table">
<caption>Nærmeste offentlige tilfluktsrom</caption>
<thead>
<tr>
<th scope="col">Adresse</th>
<th scope="col">Avstand i luftlinje</th>
<th scope="col">Koordinater</th>
</tr>
</thead>
<tbody id="tilfluktsrom-resultater"></tbody>
    </table>
</div>

<button id="tilfluktsrom-skriv-ut"
        class="shelter-print-button"
        type="button"
        hidden>
    Skriv ut
</button>
        </section>
          </div>

        <section id="checklist"
                 class="checklist-section"
                 aria-labelledby="checklist-title">
           <header class="section-heading checklist-heading">
                <h2 id="checklist-title">Sjekkliste for beredskap</h2>

                <p class="checklist-progress">
                    <strong>@completedItems.Count av @(ViewData["ChecklistItemCount"])</strong>
                    punkter fullført
                </p>

                <p class="checklist-instructions">
                    Kryss av når du har et punkt på plass. Valget lagres automatisk.
                    Trykk på samme punkt igjen hvis du vil fjerne avkryssingen.
                </p>
            </header>
            <div class="checklist-grid">
                <article class="preparedness-card">
                    <h3>Mat og vann</h3>
                    <ul>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="water" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("water") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("water") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Rent drikkevann lagret på kanner eller flasker</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="stored-food" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("stored-food") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("stored-food") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Mat som tåler lagring i romtemperatur</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="cooking-equipment" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("cooking-equipment") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("cooking-equipment") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Grill, kokeapparat eller stormkjøkken</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="fuel" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("fuel") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("fuel") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Ekstra gassbeholder eller brennstoff</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="pet-supplies" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("pet-supplies") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("pet-supplies") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Mat og vann til kjæledyr</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="cash" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("cash") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("cash") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Litt kontanter og flere betalingskort</span>
                                </label>
                            </form>
                        </li>
                    </ul>
                </article>

                <article class="preparedness-card">
                    <h3>Varme og lys</h3>
                    <ul>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="warm-clothes" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("warm-clothes") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("warm-clothes") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Varme klær og pledd, dyner eller soveposer</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="matches" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("matches") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("matches") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Fyrstikker eller stearinlys</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="firewood" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("firewood") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("firewood") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Ved dersom du har vedovn eller peis</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="heater" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("heater") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("heater") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Gass- eller parafinovn beregnet for innendørs bruk</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="overnight" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("overnight") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("overnight") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Avtale om overnatting</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="flashlights" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("flashlights") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("flashlights") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Lommelykter eller hodelykter som går på batterier, sveiv eller solceller</span>
                                </label>
                            </form>
                        </li>
                    </ul>
                </article>

                <article class="preparedness-card">
                    <h3>Informasjon</h3>
                    <ul>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="radio" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("radio") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("radio") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>DAB-radio som går på batterier, sveiv eller solceller</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="batteries" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("batteries") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("batteries") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Batterier og ladet batteribank</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="phone-list" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("phone-list") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("phone-list") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Liste på papir med viktige telefonnummer, som nødnummer, legevakt, veterinær, familie, venner og naboer</span>
                                </label>
                            </form>
                        </li>
                    </ul>
                </article>

                <article class="preparedness-card">
                    <h3>Legemidler og hygiene</h3>
                    <ul>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="medicine" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("medicine") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("medicine") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Legemidler og førstehjelpsutstyr</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="iodine" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("iodine") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("iodine") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Jodtabletter for barn og voksne under 40 år, gravide og ammende</span>
                                </label>
                            </form>
                        </li>
                        <li>
                            <form asp-area="Privat" asp-controller="Egenberedskap"
                                  asp-action="SetChecklistStatus" method="post">
                                <input type="hidden" name="itemId" value="hygiene" />
                                <input type="hidden" name="isComplete"
                                       value="@(completedItems.Contains("hygiene") ? "true" : "false")" />
                                <label class="checklist-item">
                                    <input type="checkbox"
                                           checked="@(completedItems.Contains("hygiene") ? "checked" : null)"
                                           onchange="this.form.elements['isComplete'].value = this.checked; this.form.requestSubmit();" />
                                    <span>Hygieneartikler som våtservietter, håndsprit, bleier, toalettpapir, bind og tamponger</span>
                                </label>
                            </form>
                        </li>
                    </ul>
                </article>
            </div>
        </section>
        <section id="courses"
         class="courses-section"
         aria-labelledby="courses-title">
    <header class="section-heading">
        <h2 id="courses-title">Oversikt over diverse kurs</h2>
        <p>Her er en oversikt over kurs som kan forbedre dine ferdigheter.</p>
    </header>
            <div class="courses-grid">
                <a class="course-card"
                   href="https://example.com/norsk-luftambulanse-kurs"
                   target="_blank"
                   rel="noopener noreferrer">
                    <h3>Norsk Luftambulanse online kurs</h3>
                    <p>Her får du gratis online kurs som tilbyr:</p>
                    <ul>
                        <li>CPR</li>
                        <li>Hjertestarter</li>
                        <li>Førstehjelp for barn</li>
                        <li>Gjenkjenne slag</li>
                        <li>Hvordan reagere i akutte situasjoner</li>
                    </ul>
                    <span class="course-link-text">Åpne kursoversikten ↗</span>
                </a>

                <a class="course-card"
                   href="https://example.com/roede-kors-kurs"
                   target="_blank"
                   rel="noopener noreferrer">
                    <h3>Røde Kors</h3>
                    <p>Her kan du finne kurs for:</p>
                    <ul>
                        <li>Førstehjelp grunnkurs</li>
                        <li>Førstehjelp ved ulykker</li>
                        <li>Psykisk førstehjelp</li>
                        <li>Frivillig akuttberedskap</li>
                    </ul>
                    <span class="course-link-text">Åpne kursoversikten ↗</span>
                </a>

                <a class="course-card"
                   href="https://example.com/brannvernforeningen-kurs"
                   target="_blank"
                   rel="noopener noreferrer">
                    <h3>Brannvernforeningen</h3>
                    <p>Her kan du finne kurs for:</p>
                    <ul>
                        <li>Brannforebygging</li>
                        <li>Slukkeutstyr</li>
                        <li>Evakueringsrutiner</li>
                    </ul>
                    <span class="course-link-text">Åpne kursoversikten ↗</span>
                </a>
            </div>
        </section>
    </main>
     <footer class="thank-you">
        <div class="footer-content">
            <h2>Tusen takk for din hjelp</h2>

            <p>
                Vi ønsker å rette en stor takk til alle som bidrar
                til å styrke vår felles beredskap. Enten du stiller
                ressurser til disposisjon, deler viktig informasjon
                eller på andre måter engasjerer deg, er ditt bidrag
                verdifullt.
            </p>

            <p>
                God beredskap handler om samarbeid, tillit og viljen
                til å stille opp for hverandre. Ved å samle mennesker,
                organisasjoner og tilgjengelige ressurser på ett sted,
                legger vi til rette for bedre samhandling og raskere
                respons når det virkelig gjelder.<br />
                Sammen kan vi skape et tryggere, sterkere og mer
                forberedt samfunn.
            </p>
        </div>

        <div class="footer-bottom">
            <span>Paratus</span>

            <div class="footer-links">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy">
                    Personvern
                </a>
                <span aria-hidden="true">·</span>
                <span>Kontakt</span>
            </div>
        </div>
    </footer>
<script src="~/lib/leaflet/leaflet.js"></script>
<script>
    const tilfluktsromKart = L.map('tilfluktsrom-kart')
        .setView([65, 15], 5);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(tilfluktsromKart);
</script>
<script src="~/js/tilfluktsrom-kart.js" asp-append-version="true"></script>
</body>
</html>