@{
    Layout = null;
    var offentligLogin = ViewData["OffentligLogin"] is true;
}

<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] – Paratus</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/wave-background.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-motion.css" asp-append-version="true" />
</head>

<body class="account-page @(offentligLogin ? "account-page-public" : "")">
    <header class="account-header">
        <span>Innlogging</span>
    </header>

    <partial name="/Areas/Homepage/Views/Shared/_WaveBackground.cshtml" />

    <main class="account-main">
        <a class="account-back"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">
            ← Hovedmeny
        </a>

        <div class="account-welcome">
            <h1>
                 @(offentligLogin
                     ? "Velkommen til Paratus Offentlig"
                     : "Velkommen til Paratus")
            </h1>
            <p>En enkel måte å bidra til alles sikkerhet</p>
        </div>

        @RenderBody()
    </main>

    <footer class="account-footer">
        <span>Paratus</span>

        <div class="account-footer-links">
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Personvern
            </a>

            <span aria-hidden="true">·</span>
            <span>Tilgjengelighet</span>
            <span aria-hidden="true">·</span>
            <span>Kontakt</span>
        </div>
    </footer>

    <script src="~/js/account.js"
            asp-append-version="true"></script>
</body>
</html>

