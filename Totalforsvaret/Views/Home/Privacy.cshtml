@{
    Layout = null;
    ViewData["Title"] = "Personvern";

    var isPrivateUser =
        User.Identity?.IsAuthenticated == true &&
        User.HasClaim("Brukertype", "Privat");
}

<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description"
          content="Informasjon om hvordan Paratus behandler personopplysninger." />
    <title>Personvern – Paratus</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/private-home.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/site-header.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/wave-background.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/privacy.css"
          asp-append-version="true" />
</head>

<body class="privacy-page @(isPrivateUser ? "private-home" : "")">
    @if (isPrivateUser)
    {
        <partial name="/Areas/Privat/Views/Shared/_PrivateNavigation.cshtml" />
    }
    else
    {
        <header class="public-header">
            <nav class="public-nav" aria-label="Hovedmeny">
                <div class="public-nav-pages">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        Hovedside
                    </a>
                </div>

                <div class="public-nav-account">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-button nav-button-primary"
                           asp-area="Privat"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            Min side
                        </a>
                    }
                    else
                    {
                        <a class="nav-button nav-button-primary"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="Login">
                            Logg inn
                        </a>
                    }
                </div>
            </nav>

            <div class="public-section-bar">
                <span>Personvern</span>
            </div>
        </header>
    }

    <partial name="/Views/Shared/_WaveBackground.cshtml" />

    <main class="privacy-main">
        <a class="privacy-back"
           asp-area="@(isPrivateUser ? "Privat" : "")"
           asp-controller="@(isPrivateUser ? "Dashboard" : "Home")"
           asp-action="Index">
            <span aria-hidden="true">←</span> Tilbake
        </a>

        <article class="privacy-card">
            <header class="privacy-card-header">
                <p class="privacy-eyebrow">Paratus</p>
                <h1>Personvern</h1>
                <p class="privacy-intro">
                    Her forklarer vi hvilke personopplysninger Paratus behandler,
                    hvorfor vi behandler dem, og hvilke rettigheter du har.
                </p>
                <p class="privacy-updated">
                    Sist oppdatert: <time datetime="2026-11-09">9. november 2026</time>
                </p>
            </header>

            <nav class="privacy-contents" aria-label="Innhold på siden">
                <a href="#ansvarlig">Behandlingsansvarlig</a>
                <a href="#opplysninger">Opplysninger vi behandler</a>
                <a href="#formaal">Formål og grunnlag</a>
                <a href="#deling">Tilgang og deling</a>
                <a href="#lagring">Lagring</a>
                <a href="#rettigheter">Dine rettigheter</a>
            </nav>

            <section class="privacy-section" id="ansvarlig">
                <h2>Hvem er ansvarlig?</h2>
                <p>
                    <strong>Gruppe 10</strong>
                    er behandlingsansvarlig for personopplysningene i Paratus.
                </p>
                <p>
                    Kontakt oss om personvern på
                    <a href="mailto:emmaml@uia.no"></a>
                    eller <strong>Postaddresse kommer</strong>.
                </p>
                
            </section>

            <section class="privacy-section" id="opplysninger">
                <h2>Hvilke opplysninger behandler vi?</h2>
                <p>Opplysningene avhenger av hvordan du bruker tjenesten.</p>
                <ul>
                    <li>
                        <strong>Konto:</strong> navn, e-postadresse og telefonnummer.
                    </li>
                    <li>
                        <strong>Ressurser:</strong> ressursnavn og type, tilgjengelighet,
                        tilstand, beskrivelse, adresse og kartplassering.
                    </li>
                    <li>
                        <strong>Behov og forespørsler:</strong> beskrivelse og prioritet,
                        kontaktinformasjon, eventuell frist og status.
                    </li>
                    <li>
                        <strong>Tekniske opplysninger:</strong> opplysninger som er
                        nødvendige for innlogging, sikkerhet og drift.
                        [Beskriv eventuelle logger og informasjonskapsler dere bruker.]
                    </li>
                </ul>
            </section>

            <section class="privacy-section" id="formaal">
                <h2>Hva bruker vi opplysningene til?</h2>
                <p>Vi bruker opplysningene for å:</p>
                <ul>
                    <li>opprette og administrere brukerkontoer</li>
                    <li>registrere og administrere beredskapsressurser</li>
                    <li>formidle relevante behov og ressursforespørsler</li>
                    <li>foreslå mulige treff mellom behov og tilgjengelige ressurser</li>
                    <li>beskytte og drifte tjenesten</li>
                </ul>
                <p>
                    Behandlingsgrunnlaget for disse formålene er
                    <strong>[sett inn det faktiske rettslige grunnlaget for hvert formål]</strong>.
                </p>
            </section>

            <section class="privacy-section" id="deling">
                <h2>Hvem kan se opplysningene?</h2>
                <p>
                    Tilgangen avhenger av brukerrollen. Private aktører kan administrere
                    egne ressurser. Autoriserte offentlige aktører kan se opplysninger
                    som er nødvendige for å vurdere behov og ressursforespørsler.
                </p>
                <p>
                    Tjenesten driftes ved hjelp av
                    <strong>MariaDB og docker</strong>.
                    Opplysningene blir ikke sendt utenfor EØS
                </p>
            </section>

            <section class="privacy-section" id="kartplassering">
                <h2>Kartplassering og beredskapsinformasjon</h2>
                <p>
                    Ressurser kan knyttes til en adresse eller kartplassering.
                    Opplysningene bør bare være tilgjengelige for brukere som trenger
                    dem for å utføre oppgavene sine. Ikke registrer sensitive
                    opplysninger eller mer informasjon enn nødvendig i fritekstfeltene.
                </p>
            </section>

            <section class="privacy-section" id="automatiske-forslag">
                <h2>Automatiske forslag</h2>
                <p>
                    Paratus kan foreslå mulige treff mellom registrerte behov og
                    ressurser, blant annet ut fra kategori og avstand. Forslagene er
                    støtte for vurderingen. En bruker vurderer og tar den endelige
                    avgjørelsen.
                </p>
            </section>

            <section class="privacy-section" id="lagring">
                <h2>Hvor lenge lagrer vi opplysningene?</h2>
                <p>
                    Opplysninger lagres så lenge det er nødvendig for formålene de ble
                    samlet inn for. Kontoopplysninger, ressursregistreringer,
                    forespørsler og tekniske logger kan ha ulike lagringstider.
                </p>
                <p>
                    <strong>
                        Sletterutiner kommer -
                    </strong>
                </p>
            </section>

            <section class="privacy-section" id="rettigheter">
                <h2>Dine rettigheter</h2>
                <p>
                    Du kan be om innsyn i opplysningene dine og be om at uriktige
                    opplysninger rettes. Du kan også be om sletting eller begrensning,
                    eller protestere mot behandling når vilkårene for dette er oppfylt.
                </p>
                <p>
                    Kontakt <a href="mailto:emmaml@uia.no"></a>
                    for å bruke rettighetene dine. Du kan klage til
                    <a href="https://www.datatilsynet.no/" rel="noopener noreferrer">
                        Datatilsynet
                    </a>.
                </p>
            </section>

            <section class="privacy-section" id="plikt">
                <h2>Må du oppgi opplysningene?</h2>
                <p>
                    Noen opplysninger er nødvendige for å opprette konto eller bruke
                    bestemte funksjoner. Hvis du ikke oppgir dem, kan det hende at
                    funksjonen ikke kan brukes. Andre opplysninger er valgfrie.
                    
                </p>
            </section>
        </article>
    </main>

    <footer class="privacy-footer">
        <span>Paratus</span>
        <nav aria-label="Bunnmeny">
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">Personvern</a>
            <span aria-hidden="true">·</span>
            <a href="#tilgjengelighet">Tilgjengelighet</a>
            <span aria-hidden="true">·</span>
            <a href="#kontakt">Kontakt</a>
        </nav>
    </footer>
</body>
</html>