@using Totalforsvaret.Models
@model Totalforsvaret.Models.Crisis

<aside class="incident-alert@(Model.Severity == CrisisSeverity.High ? " incident-alert-high" : "")"
       aria-label="Hendelsesvarsel"
       data-incident-key="krise-@Model.Id-@Model.Severity.ToNorwegianText()">
    <button class="incident-alert-close" type="button" data-incident-dismiss aria-label="Lukk hendelsesvarselet">
        <span aria-hidden="true">×</span>
    </button>
    <div class="incident-alert-heading">
        <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 4 37 34H3Z" stroke-linejoin="round" />
            <path d="M20 14v10" />
            <circle cx="20" cy="29" r="1" fill="currentColor" />
        </svg>
        <div>
            <p class="incident-alert-label">@Model.Severity.ToNorwegianText() · @Model.Type · @Model.Status.ToNorwegianText()</p>
            <h2>@Model.Name</h2>
        </div>
    </div>
    <p class="incident-alert-description">@Model.Description</p>
    <p class="incident-alert-updated">
        Startet <time datetime="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm:ss")">@Model.StartTime.ToString("dd.MM.yyyy 'kl.' HH:mm")</time>
    </p>
</aside>
<script src="~/js/incident-alert.js" asp-append-version="true" defer></script>
