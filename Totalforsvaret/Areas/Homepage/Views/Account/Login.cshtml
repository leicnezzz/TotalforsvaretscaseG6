@model Totalforsvaret.Models.LoginInput

@{
    Layout = "_AccountLayout";

    var offentligLogin = ViewData["OffentligLogin"] is true;

    ViewData["Title"] = offentligLogin
        ? "Logg inn – Offentlig"
        : "Logg inn";
}

<section class="account-card account-card-login"
         aria-labelledby="login-title">
    <h2 id="login-title">Logg inn</h2>
    <p class="account-intro">Logg inn for å fortsette.</p>

    @if (ViewData["FormError"] is string error)
    {
        <p class="account-message account-error" role="alert">
            @error
        </p>
    }

    @if (TempData["AccountMessage"] is string notice)
    {
        <p class="account-message account-notice" role="status">
            @notice
        </p>
    }

    <form asp-area=""
          asp-controller="Account"
          asp-action="@(offentligLogin ? "LoginOffentlig" : "Login")"
          method="post">
        <div class="account-field">
            <label asp-for="Email">E-post</label>

            <div class="account-input">
                <svg class="account-field-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.4"
                     aria-hidden="true">
                    <circle cx="12" cy="7" r="4" />
                    <path d="M4 22v-2a8 8 0 0 1 16 0v2" />
                </svg>

                <input asp-for="Email"
                       type="email"
                       autocomplete="username"
                       placeholder="Skriv inn e-post"
                       required />
            </div>

            <span asp-validation-for="Email"
                  class="account-validation"></span>
        </div>

        <div class="account-field">
            <label asp-for="Password">Passord</label>

            <div class="account-input">
                <svg class="account-field-icon"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.4"
                     aria-hidden="true">
                    <rect x="5" y="10" width="14" height="11" rx="2" />
                    <path d="M8 10V6a4 4 0 0 1 8 0v4" />
                </svg>

                <input asp-for="Password"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Skriv inn passord"
                       required />

                <button class="account-password-toggle"
                        type="button"
                        data-password-toggle
                        aria-controls="Password"
                        aria-label="Vis passord"
                        aria-pressed="false">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5"
                         aria-hidden="true">
                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>

            <span asp-validation-for="Password"
                  class="account-validation"></span>
        </div>

        <button class="account-submit" type="submit">
            Logg inn
        </button>

        <div class="account-links">
            @if (!offentligLogin)
            {
                <a asp-area=""
                   asp-controller="Account"
                   asp-action="Register">
                    Opprett bruker
                </a>
            }

            <a asp-area=""
               asp-controller="Account"
               asp-action="ForgotPassword">
                Husker du ikke passordet ditt?
            </a>
        </div>
    </form>
</section>

<p class="account-quote">
    «Når noe skjer, står vi<br />
    <strong>sammen.»</strong>
</p>