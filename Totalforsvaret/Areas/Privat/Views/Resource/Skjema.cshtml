@model Totalforsvaret.Areas.Privat.Models.FormDataModel
@{
    Layout = null;
    ViewData["PrivateSection"] = "Ressursregistrering";
    ViewData["PrivateBack"] = true;
    var navn = User.Identity?.Name ?? "Min konto";
    var initialer = string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(del => char.ToUpperInvariant(del[0])));
}
<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registrer ressurs – Paratus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/private-home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/incident-alert.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-motion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/css/resource-wizard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/resource-registration.css" asp-append-version="true" />
    <script src="~/js/help-dismiss.js" asp-append-version="true" defer></script>
</head>
<body class="private-home resource-registration">
@{
    ViewData["PrivateSection"] = "Ressursregistrering";
}

<partial name="/Areas/Privat/Views/Shared/_PrivateNavigation.cshtml" />
    <partial name="/Views/Shared/_PrivatePageAction.cshtml" />
    <main class="registration-main">
        <div class="registration-content">
            <partial name="/Views/Shared/_IncidentAlert.cshtml" />
            <section class="registration-intro" aria-labelledby="registration-title">
                <h1 id="registration-title">Registrere en ressurs til disposisjon</h1>
                <p>Registrer kjøretøy, utstyr eller andre ressurser som kan bidra i en beredskapssituasjon.</p>
            </section>
            <div id="registrer-ressurs"><partial name="/Views/Shared/_ResourceWizard.cshtml" model="Model.Categories" /></div>
        </div>
    </main>
    <partial name="/Views/Shared/_RegistrationFooter.cshtml" />
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/resource-fields.js" asp-append-version="true"></script>
    <script src="~/js/resource-address.js" asp-append-version="true"></script>
    <script src="~/js/resource-wizard.js" asp-append-version="true"></script>
    <partial name="/Views/Shared/_ResourceApi.cshtml" />
</body>
</html>