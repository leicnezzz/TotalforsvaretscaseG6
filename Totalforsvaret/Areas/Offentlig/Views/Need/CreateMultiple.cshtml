@model Totalforsvaret.Areas.Offentlig.ViewModels.MultipleNeedsViewModel

@{
    ViewData["Title"] = "Registrer flere behov";
}

<link rel="stylesheet"
      href="~/css/offentlig-aktor.css"
      asp-append-version="true" />

<div class="container pt-4 pb-5 mb-5 offentlig-behov-side">
    <a asp-area=""
       asp-controller="OffentligAktor"
       asp-action="Index"
       class="tilbake-oversikt">
        ← Tilbake til oversikten
    </a>

    <h1>@ViewData["Title"]</h1>
    <p>Velg en krise og registrer ressursbehovene som hører til.</p>

    <form asp-area="Offentlig"
          asp-controller="Need"
          asp-action="CreateMultiple"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="CrisisId" class="form-label">
                Tilknyttet krise
            </label>
            <select asp-for="CrisisId"
                    asp-items="Model.Crises"
                    class="form-select">
                <option value="">Velg krise</option>
            </select>
            <span asp-validation-for="CrisisId"
                  class="text-danger"></span>
        </div>

        <div id="behov-liste">
            @for (var i = 0; i < Model.Needs.Count; i++)
            {
                <fieldset class="behov-element mb-4">
                    <legend class="h5">Behov @(i + 1)</legend>
                    <button type="button"
                            class="btn btn-outline-danger btn-sm fjern-behov mb-3">
                        Fjern behov
                    </button>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Needs[i].Name" class="form-label">
                                Navn på behovet
                            </label>
                            <input asp-for="Needs[i].Name"
                                   class="form-control"
                                   placeholder="For eksempel Transport av personer"
                                   maxlength="100" />
                            <span asp-validation-for="Needs[i].Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Needs[i].Type" class="form-label">
                                Type behov
                            </label>
                            <select asp-for="Needs[i].Type" class="form-select">
                                <option value="">Velg type</option>
                                <option value="Utstyr">Utstyr</option>
                                <option value="Transport">Kjøretøy</option>
                            </select>
                            <span asp-validation-for="Needs[i].Type"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Needs[i].Priority" class="form-label">
                                Prioritet
                            </label>
                            <select asp-for="Needs[i].Priority" class="form-select">
                                <option value="">Velg prioritet</option>
                                <option value="Lav">Lav</option>
                                <option value="Middels">Middels</option>
                                <option value="Høy">Høy</option>
                                <option value="Kritisk">Kritisk</option>
                            </select>
                            <span asp-validation-for="Needs[i].Priority"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Needs[i].Status" class="form-label">
                                Status
                            </label>
                            <select asp-for="Needs[i].Status" class="form-select">
                                <option value="Åpen">Åpen</option>
                                <option value="Under behandling">Under behandling</option>
                                <option value="Løst">Løst</option>
                            </select>
                            <span asp-validation-for="Needs[i].Status"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Needs[i].Description" class="form-label">
                            Beskrivelse
                        </label>
                        <textarea asp-for="Needs[i].Description"
                          class="form-control"
                          rows="3"
                          maxlength="1500"></textarea>
                        <span asp-validation-for="Needs[i].Description"
                              class="text-danger"></span>
                    </div>
                </fieldset>
            }
        </div>

        <button type="button"
                id="legg-til-behov"
                class="btn btn-outline-secondary">
            + Legg til behov
        </button>
    

        <div class="mt-4 pt-4 border-top">
            <h2 class="h5">Hvor trengs ressursene?</h2>
            <p class="text-muted">
                Velg en felles plassering for behovene på kartet.
            </p>

            <div id="behovKart" style="height: 350px; width: 100%;"></div>

            <input asp-for="Latitude" type="hidden" />
            <input asp-for="Longitude" type="hidden" />

            <span asp-validation-for="Latitude" class="text-danger"></span>
            <span asp-validation-for="Longitude" class="text-danger"></span>

            <p id="behovKartmelding" class="small text-muted mt-2">
                Ingen plassering valgt.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-success">
                Registrer behovene
            </button>

            <a asp-area=""
               asp-controller="OffentligAktor"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Avbryt
            </a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const behovListe = document.getElementById('behov-liste');
        const leggTilKnapp = document.getElementById('legg-til-behov');
        function oppdaterFjernKnapper() {
            const bareEttBehov =
                behovListe.querySelectorAll('fieldset').length <= 1;

            behovListe.querySelectorAll('.fjern-behov').forEach(knapp => {
                knapp.hidden = bareEttBehov;
            });
        }

        oppdaterFjernKnapper();
        behovListe.addEventListener('click', e => {
            const knapp = e.target.closest('.fjern-behov');

            if (!knapp) return;

            const behov = behovListe.querySelectorAll('fieldset');

            // Behold alltid minst ett behov.
            if (behov.length <= 1) return;

            knapp.closest('fieldset').remove();
            oppdaterFjernKnapper();

            // Oppdater nummer og feltnavn etter sletting.
            behovListe.querySelectorAll('fieldset').forEach((blokk, indeks) => {
                blokk.querySelector('legend').textContent =
                    `Behov ${indeks + 1}`;

                blokk.querySelectorAll('*').forEach(element => {
                    ['name', 'id', 'for', 'data-valmsg-for'].forEach(attributt => {
                        const verdi = element.getAttribute(attributt);

                        if (verdi) {
                            element.setAttribute(
                                attributt,
                                verdi
                                    .replace(/Needs\[\d+\]/g, `Needs[${indeks}]`)
                                    .replace(/Needs_\d+__/g, `Needs_${indeks}__`)
                            );
                        }
                    });
                });
            });

            const skjema = $(behovListe.closest('form'));
            skjema.removeData('validator');
            skjema.removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse(skjema);
        });

        leggTilKnapp.addEventListener('click', () => {
            const indeks = behovListe.querySelectorAll('fieldset').length;
            const nyttBehov = behovListe
                .querySelector('fieldset')
                .cloneNode(true);

            nyttBehov.querySelector('legend').textContent =
                `Behov ${indeks + 1}`;

            nyttBehov.querySelectorAll('*').forEach(element => {
                ['name', 'id', 'for', 'data-valmsg-for'].forEach(attributt => {
                    const verdi = element.getAttribute(attributt);

                    if (verdi) {
                        element.setAttribute(
                            attributt,
                            verdi
                                .replace(/Needs\[\d+\]/g, `Needs[${indeks}]`)
                                .replace(/Needs_\d+__/g, `Needs_${indeks}__`)
                        );
                    }
                });
            });

            nyttBehov.querySelectorAll('input, textarea').forEach(felt => {
                felt.value = '';
                felt.classList.remove('input-validation-error');
            });

            nyttBehov.querySelectorAll('select').forEach(felt => {
                felt.selectedIndex = 0;
                felt.classList.remove('input-validation-error');
            });

            nyttBehov.querySelectorAll('[data-valmsg-for]').forEach(melding => {
                melding.textContent = '';
                melding.classList.remove('field-validation-error');
                melding.classList.add('field-validation-valid');
            });

            behovListe.appendChild(nyttBehov);
            oppdaterFjernKnapper(); 

            const skjema = $(behovListe.closest('form'));
            skjema.removeData('validator');
            skjema.removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse(skjema);

            nyttBehov.querySelector('input').focus();
        });
        const kartmelding = document.getElementById('behovKartmelding');
        const latitudeInput = document.getElementById('Latitude');
        const longitudeInput = document.getElementById('Longitude');

        if (typeof L !== 'undefined') {
            const kart = L.map('behovKart')
                .setView([58.1467, 7.9956], 12);

            L.tileLayer(
                'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }
            ).addTo(kart);

            let markor = null;

            function visPlassering(latitude, longitude) {
                const plassering = [latitude, longitude];

                if (markor) {
                    markor.setLatLng(plassering);
                } else {
                    markor = L.marker(plassering).addTo(kart);
                }

                kartmelding.textContent =
                    `Valgt plassering: ${latitude.toFixed(5)}, ${longitude.toFixed(5)}`;
            }

            // Beholder valgt plassering hvis skjemaet får valideringsfeil.
            if (latitudeInput.value.trim() && longitudeInput.value.trim()) {
                const latitude = Number(latitudeInput.value.replace(',', '.'));
                const longitude = Number(longitudeInput.value.replace(',', '.'));

                if (Number.isFinite(latitude) &&
                    Number.isFinite(longitude) &&
                    latitude >= -90 && latitude <= 90 &&
                    longitude >= -180 && longitude <= 180) {
                    visPlassering(latitude, longitude);
                    kart.setView([latitude, longitude], 12);
                }
            }

            kart.on('click', e => {
                const latitude = e.latlng.lat;
                const longitude = e.latlng.lng;

                latitudeInput.value = latitude;
                longitudeInput.value = longitude;

                visPlassering(latitude, longitude);
            });
        } else {
            kartmelding.textContent = 'Kartet kunne ikke lastes.';
        }
    </script>
}