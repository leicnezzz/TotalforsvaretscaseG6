@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Glemt passord – Paratus</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-page">
        <header class="brand-header">
            <a href="/Home/Index" aria-label="Paratus – forsiden"><img src="~/images/login/image-1-2.png" alt="Paratus – Mennesket som ressurs" /></a>
        </header>
        <main class="login-main">
            <div class="landscape" aria-hidden="true">
                <img class="landscape-base" src="~/images/login/vector-35.svg" alt="" />
                <img class="hill hill-back" src="~/images/login/vector-36.svg" alt="" />
                <img class="hill hill-middle" src="~/images/login/vector-37.svg" alt="" />
                <img class="hill hill-front" src="~/images/login/vector-38.svg" alt="" />
                <img class="landscape-line" src="~/images/login/vector-40.svg" alt="" />
                <div class="leaves leaves-top"><img src="~/images/login/vector-46.svg" alt="" /><img src="~/images/login/vector-47.svg" alt="" /><img src="~/images/login/vector-48.svg" alt="" /></div><div class="leaves leaves-bottom"><img src="~/images/login/vector-46.svg" alt="" /><img src="~/images/login/vector-47.svg" alt="" /><img src="~/images/login/vector-48.svg" alt="" /></div>
            </div>
            <section class="login-panel" aria-labelledby="forgot-title">
    <span class="accent" aria-hidden="true"></span>
    <h1 id="forgot-title" style="margin-top:28px">Glemt passord?</h1>
    <p>Skriv inn e-postadressen til brukeren din.</p>
    <form id="forgot-password-form">
        <label for="email">Mail</label>
        <div class="input-wrap"><input id="email" name="email" type="email" autocomplete="email" placeholder="Skriv inn mail" required /></div>
        <p class="required-note">E-postutsending er ikke tilgjengelig ennå.</p>
        <a class="register-button" href="/Account/Login">Tilbake til innlogging</a>
    </form>
</section>
            <aside class="quote"><blockquote>“Sterkere mennesker<br />bygger sterkere samfunn”</blockquote><span class="accent" aria-hidden="true"></span></aside>
        </main>
        <footer class="login-footer"><p><strong>Paratus</strong><span class="separator">|</span>Mennesket som ressurs</p><nav aria-label="Informasjon"><a asp-controller="Home" asp-action="Privacy">Personvern</a><span class="separator">|</span><button type="button" data-info="Kontakt oss for informasjon om tilgjengelighet.">Tilgjengelighet</button><span class="separator">|</span><button type="button" data-info="Kontaktinformasjon kommer snart.">Kontakt</button></nav></footer>
    </div>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
