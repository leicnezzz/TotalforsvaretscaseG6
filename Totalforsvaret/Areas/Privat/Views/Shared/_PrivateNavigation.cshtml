@using System
@using System.Linq
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Totalforsvaret.DataAccess
@using Totalforsvaret.Models
@inject UserManager<Bruker> UserManager
@inject AppDbContext Db

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isDashboard = controller.Equals("Dashboard", StringComparison.OrdinalIgnoreCase);

    var isResourceForm =
        controller.Equals("Resource", StringComparison.OrdinalIgnoreCase) &&
        action.Equals("Skjema", StringComparison.OrdinalIgnoreCase);

    var isResourceOverview =
        controller.Equals("Resource", StringComparison.OrdinalIgnoreCase) &&
        action.Equals("Oversikt", StringComparison.OrdinalIgnoreCase);

    var isProfile = controller.Equals("Profile", StringComparison.OrdinalIgnoreCase);
    
    var isInbox = controller.Equals("Inbox", StringComparison.OrdinalIgnoreCase);

    var isEgenberedskap =
        controller.Equals("Egenberedskap", StringComparison.OrdinalIgnoreCase);
    
    var isPrivacy =
        controller.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
        action.Equals("Privacy", StringComparison.OrdinalIgnoreCase);

    var sectionName = isDashboard ? "Min side"
        : isResourceForm ? "Ressursregistrering"
        : isResourceOverview ? "Mine ressurser"
        : isProfile ? "Min profil"
        : isEgenberedskap ? "Egenberedskap"
        : isInbox ? "Innboks"
        : isPrivacy ? "Personvern"
        : "Brukeroversikt";

    var account = await UserManager.GetUserAsync(User);
    var displayName = account?.Navn ?? User.Identity?.Name ?? "Privat aktør";
    var hasPhoto = account != null && await Db.ProfilePhotos.AnyAsync(photo => photo.BrukerId == account.Id);

    var initials = string.Concat(
        displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
}

<header class="site-header">
    <nav class="primary-nav @(isDashboard ? "nav-with-brand" : "")" aria-label="Hovedmeny">
        <div class="nav-links">
            <a class="@(isDashboard ? "active" : "")"
               aria-current="@(isDashboard ? "page" : null)"
               asp-area="Privat"
               asp-controller="Dashboard"
               asp-action="Index">
                Min side
            </a>

            <a class="@(isResourceForm ? "active" : "")"
               aria-current="@(isResourceForm ? "page" : null)"
               asp-area="Privat"
               asp-controller="Resource"
               asp-action="Skjema">
                Ressursregistrering
            </a>

            <a class="@(isResourceOverview ? "active" : "")"
               aria-current="@(isResourceOverview ? "page" : null)"
               asp-area="Privat"
               asp-controller="Resource"
               asp-action="Oversikt">
                Mine ressurser
            </a>

            <a class="@(isEgenberedskap ? "active" : "")"
               aria-current="@(isEgenberedskap ? "page" : null)"
               asp-area="Privat"
               asp-controller="Egenberedskap"
               asp-action="Index">
                Egenberedskap
            </a>
            
        </div>

        @if (isDashboard)
        {
            <a class="nav-brand paratus-brand" asp-area="Privat" asp-controller="Dashboard" asp-action="Index">
                <span class="paratus-brand-text"><strong>PARATUS</strong><small>Mennesket som ressurs</small></span>
            </a>
        }

        <div class="account-actions">
            <a class="inbox-icon-link"
               asp-area="Privat"
               asp-controller="Inbox"
               asp-action="Index"
               aria-label="Åpne innboksen"
               aria-current="@(isInbox ? "page" : null)">
                <svg class="bell"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     aria-hidden="true">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" />
                    <path d="M10 21h4" />
                </svg>
            </a>

            <details class="account-menu">
                <summary class="account-link @(isProfile ? "active" : "")"
                         aria-label="Brukermeny for @displayName">
                    @if (hasPhoto)
                    {
                        <img class="avatar avatar-small"
                             src="@Url.Action("Photo", "Profile", new { area = "Privat" })"
                             alt="" />
                    }
                    else
                    {
                        <span class="avatar avatar-small" aria-hidden="true">@initials</span>
                    }

                    <span class="account-copy">
                        <strong>@displayName</strong>
                        <small>Privat aktør</small>
                    </span>
                    <span class="chevron" aria-hidden="true">⌄</span>
                </summary>

                <ul class="account-menu-list">
                    <li>
                        <a asp-area="Privat" asp-controller="Profile" asp-action="Index"
                           aria-current="@(isProfile ? "page" : null)">Min profil</a>
                    </li>
                    <li>
                        <a asp-area="Privat" asp-controller="Dashboard" asp-action="Index"
                           aria-current="@(isDashboard ? "page" : null)">Min side</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy"
                           aria-current="@(isPrivacy ? "page" : null)">Personvern</a>
                    </li>
                    <li>
                        <form id="private-logout"
                              asp-area="" asp-controller="Account" asp-action="Logout" method="post"
                              onsubmit="return window.confirm('Er du sikker på at du vil logge ut?');">
                            <button type="submit">Logg ut</button>
                        </form>
                    </li>
                </ul>
            </details>
        </div>
    </nav>

   
    <div class="section-bar">
        <span>@sectionName</span>
    </div>
    
</header>