@using System
@using System.Linq
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Totalforsvaret.DataAccess
@using Totalforsvaret.Models
@inject UserManager<Bruker> UserManager
@inject AppDbContext Db

@{
    var eventQuery = Microsoft.AspNetCore.Http.QueryString.Create(
        Context.Request.Query["hendelser"].Select(id => new KeyValuePair<string, string?>("hendelser", id))).ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isMatch = ViewContext.RouteData.Values["match"] is true;
    var isResourcePage =
        action.Equals("ResourceRegistration",
            StringComparison.OrdinalIgnoreCase);
    var isOverview =
        !isMatch &&
        controller.Equals("OffentligAktor",
            StringComparison.OrdinalIgnoreCase);
    var isNeedPage =
        controller.Equals("Need", StringComparison.OrdinalIgnoreCase);
    var isCrisisPage =
        controller.Equals("Crisis", StringComparison.OrdinalIgnoreCase);
    var isProfile =
        controller.Equals("Profile", StringComparison.OrdinalIgnoreCase);

    var account = await UserManager.GetUserAsync(User);
    var displayName = account?.Navn
        ?? User.Identity?.Name
        ?? "Offentlig aktør";
    var hasPhoto = account != null &&
        await Db.ProfilePhotos.AnyAsync(
            photo => photo.BrukerId == account.Id);

    var initials = string.Concat(
        displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
}

<header class="site-header offentlig-site-header">
    <nav class="primary-nav" aria-label="Hovedmeny">
        <div class="nav-links">
            <a class="@(isOverview ? "active" : "")"
               aria-current="@(isOverview ? "page" : null)"
               href="@(Url.Action("Index", "OffentligAktor", new { area = "" }) + eventQuery)">
                Oversikt
            </a>

            <a href="@(Url.RouteUrl("crisis-overview") + eventQuery)" class="@(isCrisisPage ? "active" : "")" aria-current="@(isCrisisPage ? "page" : null)">Hendelser</a>
            <a asp-route="behov" class="@(isNeedPage ? "active" : "")" aria-current="@(isNeedPage ? "page" : null)">Registrer behov</a>
            <a asp-route="ressursregistrering" class="@(isResourcePage ? "active" : "")" aria-current="@(isResourcePage ? "page" : null)">Registrer ressurs</a>
            <a asp-route="offentlig-match" class="@(isMatch ? "active" : "")" aria-current="@(isMatch ? "page" : null)">Match</a>
        </div>

        @if (isOverview && action.Equals(
            "Index", StringComparison.OrdinalIgnoreCase))
        {
            <div id="kartSokToolbar"></div>
        }

        <div class="account-actions">
            <details class="account-menu">
                <summary class="account-link @(isProfile ? "active" : "")"
                         aria-label="Brukermeny for @displayName">
                    @if (hasPhoto)
                    {
                        <img class="avatar avatar-small"
                             src="@Url.Action(
                                      "Photo",
                                      "Profile",
                                      new { area = "Offentlig" })"
                             alt="" />
                    }
                    else
                    {
                        <span class="avatar avatar-small" aria-hidden="true">
                            @initials
                        </span>
                    }

                    <span class="account-copy">
                        <strong>@displayName</strong>
                        <small>Offentlig aktør</small>
                    </span>
                    <span class="chevron" aria-hidden="true">⌄</span>
                </summary>

                <ul class="account-menu-list">
                    <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Personvern</a></li>
                    <li>
                        <a asp-area="Offentlig"
                           asp-controller="Profile"
                           asp-action="Index">
                            Min profil
                        </a>
                    </li>
                    <li>
                        <a asp-area="Offentlig"
                           asp-controller="Inbox"
                           asp-action="Index">
                            Innboks
                        </a>
                    </li>
                    <li>
                        <form asp-area=""
                              asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit">Logg ut</button>
                        </form>
                    </li>
                </ul>
            </details>
        </div>
    </nav>
</header>